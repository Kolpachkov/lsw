#!/usr/bin/env bash
# lsw — WSL-подобные headless-VM для Linux на QEMU/KVM (гости: Ubuntu, Arch, Windows 10; Ubuntu arm64 — эмуляция)
set -euo pipefail

LSW_HOME=${LSW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lsw}
VMS=$LSW_HOME/vms
CACHE=$LSW_HOME/cache
KEY=$LSW_HOME/id_ed25519
LSW_VERSION=0.6.0
LSW_REPO=${LSW_REPO:-Kolpachkov/lsw} # откуда lsw upgrade берёт релизы
WIN_GENERIC_KEY=VK7JG-NPHTM-C97JM-9MPGT-3V66T # публичный generic-ключ Win10 Pro: только установка, без активации

die()  { printf '\e[1;31mlsw:\e[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\e[1;34m::\e[0m %s\n' "$*" >&2; }
warn() { printf '\e[1;33m!!\e[0m %s\n' "$*" >&2; }

usage() {
	cat <<'EOF'
lsw — лёгкие терминальные виртуалки (Linux / Windows 10) на QEMU/KVM

  lsw install <ubuntu|ubuntu-24.04|ubuntu-22.04|arch> [имя] [опции]
  lsw install ubuntu  [имя] --iso ubuntu-XX.04-live-server-amd64.iso  (автоустановка с ISO)
  lsw install windows [имя] --iso Win10.iso [опции]
      --cpus N        (linux 2, windows 4)
      --mem  4G       (linux 2G, windows 4G)
      --disk 40G      (linux 20G, windows 64G)
      --arch arm64    ARM-гость (только ubuntu*, без KVM — программная эмуляция, в разы медленнее)
      --share DIR[:ro]  открыть папку хоста в госте как /mnt/host (:ro — только чтение);
                        по умолчанию VM изолирована и ничего с хоста не видит
      --password P    пароль пользователя (по умолчанию = имя пользователя)
      --key XXXXX-... ключ продукта Windows (по умолчанию generic Pro)
      --edition N     индекс редакции в install.wim/esd
      --lang ru-RU    язык ISO Windows (обычно определяется сам)
      --vnc           включить VNC 127.0.0.1:59xx (посмотреть, что с установкой Windows)

  lsw                       shell в VM по умолчанию
  lsw shell [имя]           терминал гостя (VM запустится сама); то же: lsw <имя>
  lsw run <имя> [-- cmd...] выполнить команду в госте (без команды — терминал)
  lsw list                  список VM
  lsw start|stop|restart <имя>
  lsw stop --all
  lsw console <имя>         серийная консоль (выход: Ctrl+])
  lsw logs <имя>            лог консоли
  lsw default <имя>         VM по умолчанию
  lsw share [имя] [DIR[:ro]|off]  показать / сменить общую папку (без имени — VM по умолчанию)
  lsw set [имя] [--cpus N] [--mem 4G] [--disk 40G|+10G]
                            показать / изменить ресурсы VM (диск — только увеличить)
  lsw port [имя] [HOST[:GUEST]] открыть порт гостя на 127.0.0.1:HOST хоста (без порта — список)
      0.0.0.0:8080:80  — доступно из сети;  8080/udp — UDP;  lsw port [имя] rm 8080
  lsw snapshot [имя] [list|save [метка]|restore <метка> [-f]|rm <метка>]
                            снимки диска; save работает и на запущенной VM
  lsw ssh-config [имя]      блок для ~/.ssh/config (scp, rsync, VS Code)
  lsw rm <имя> [-f]         удалить VM
  lsw pull <дистрибутив>    перекачать базовый образ
  lsw deps                  проверить зависимости
  lsw version               версия и путь к скрипту
  lsw upgrade [--check]     обновить lsw (git pull или последний релиз); VM не трогаются
  lsw upgrade --from F.tar.gz  обновить из скачанного архива (без интернета)
EOF
}

# ---------- зависимости ----------

find_virtiofsd() {
	# нужен Rust-virtiofsd (--shared-dir); старый C-вариант из qemu 6.x (Ubuntu 22.04) не подходит
	local p
	for p in "$(command -v virtiofsd 2>/dev/null)" /usr/lib/virtiofsd /usr/libexec/virtiofsd /usr/lib/qemu/virtiofsd; do
		[[ -n $p && -x $p ]] && "$p" --help 2>&1 | grep -q -- --shared-dir && { echo "$p"; return; }
	done
	return 1
}

cmd_deps() {
	local missing=() c
	for c in qemu-system-x86_64 qemu-img xorriso socat ssh ssh-keygen curl; do
		command -v "$c" >/dev/null || missing+=("$c")
	done
	find_virtiofsd >/dev/null || missing+=(virtiofsd)
	[[ -w /dev/kvm ]] || warn "/dev/kvm недоступен для записи — без KVM будет очень медленно"
	if ((${#missing[@]})); then
		warn "не хватает: ${missing[*]}"
		if command -v apt-get >/dev/null; then
			echo "  sudo apt install qemu-system-x86 qemu-utils ipxe-qemu virtiofsd xorriso socat openssh-client curl" >&2
		elif command -v dnf >/dev/null; then
			echo "  sudo dnf install qemu-kvm qemu-img virtiofsd xorriso socat openssh-clients curl" >&2
		else
			echo "  sudo pacman -S --needed qemu-base libisoburn socat 7zip openssh curl" >&2
		fi
		[[ ${1:-} == quiet ]] && exit 1
		return 1
	fi
	[[ ${1:-} == quiet ]] && return
	find_aarch64 >/dev/null || warn "для arm64-гостей нужны qemu-system-aarch64 и UEFI: sudo pacman -S qemu-system-aarch64 edk2-aarch64 / sudo apt install qemu-system-arm qemu-efi-aarch64"
	find_7z >/dev/null || warn "для Windows желателен 7z (читает ISO Microsoft): sudo pacman -S 7zip / sudo apt install 7zip"
	info "все зависимости на месте"
}

# UEFI-прошивка для arm64 (virt): Arch/Fedora edk2-aarch64, Debian/Ubuntu qemu-efi-aarch64
find_aavmf() {
	local f
	for f in /usr/share/edk2/aarch64/QEMU_EFI.fd /usr/share/qemu-efi-aarch64/QEMU_EFI.fd \
		/usr/share/edk2-armvirt/aarch64/QEMU_EFI.fd /usr/share/AAVMF/AAVMF_CODE.fd; do
		[[ -f $f ]] && { echo "$f"; return; }
	done
	return 1
}

find_aarch64() { command -v qemu-system-aarch64 >/dev/null && find_aavmf; }

ensure_key() {
	[[ -f $KEY ]] || ssh-keygen -q -t ed25519 -N '' -C lsw -f "$KEY"
}

# ---------- VM: конфиг и состояние ----------

vm_dir() { echo "$VMS/$1"; }

load_vm() {
	NAME=$1
	DIR=$(vm_dir "$NAME")
	[[ -f $DIR/vm.conf ]] || die "VM '$NAME' не найдена (lsw list)"
	ARCH=amd64 # VM до 0.5.0 — без ARCH в vm.conf
	# shellcheck disable=SC1091
	source "$DIR/vm.conf"
}

conf_set() { # key value
	# без sed: в значении бывают пробелы, \ и | (printf %q)
	local line
	line=$(printf '%s=%q' "$1" "$2")
	{ grep -v "^$1=" "$DIR/vm.conf" || true; echo "$line"; } >"$DIR/vm.conf.new"
	mv -f "$DIR/vm.conf.new" "$DIR/vm.conf"
	printf -v "$1" '%s' "$2" # и в текущем процессе, чтобы перезапуск взял новое значение
}

default_vm() {
	if [[ -f $LSW_HOME/default ]]; then cat "$LSW_HOME/default"; fi
}

resolve_name() { # [имя] -> имя, иначе VM по умолчанию
	local n=${1:-$(default_vm)}
	[[ -n $n ]] || die "не указано имя VM и нет VM по умолчанию (lsw default <имя>)"
	echo "$n"
}

qemu_pid() {
	local pid
	[[ -f $DIR/qemu.pid ]] || return 1
	pid=$(<"$DIR/qemu.pid")
	[[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && grep -q qemu "/proc/$pid/comm" 2>/dev/null || return 1
	echo "$pid"
}

is_running() { qemu_pid >/dev/null; }

# порты хоста, занятые VM (ssh и проброшенные): "порт vm" по строке
vm_host_ports() {
	local c
	for c in "$VMS"/*/vm.conf; do
		[[ -f $c ]] || continue
		(
			FWDS=''
			# shellcheck disable=SC1090
			source "$c"
			n=$(basename "$(dirname "$c")")
			echo "$PORT $n"
			for f in $FWDS; do IFS=: read -r _ _ h _ <<<"$f" && echo "$h $n"; done
		)
	done
}

free_port() {
	local p=2222 used
	used=$(vm_host_ports | cut -d' ' -f1)
	while grep -qx "$p" <<<"$used" || ss -Hltn "sport = :$p" 2>/dev/null | grep -q .; do
		((p++))
	done
	echo "$p"
}

# ---------- ssh ----------

ssh_opts() {
	SSH=(ssh -i "$KEY" -p "$PORT"
		-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
		-o LogLevel=ERROR -o BatchMode=yes -o ServerAliveInterval=30
		# одно соединение на VM: повторные run/shell не делают новый ssh-handshake
		-o ControlMaster=auto -o ControlPath="$DIR/ssh.sock" -o ControlPersist=10m)
}

ssh_close() { # закрыть фоновое мастер-соединение (перед остановкой/перезапуском VM)
	[[ -S $DIR/ssh.sock ]] || return 0
	ssh_opts
	"${SSH[@]}" -O exit "$VMUSER@127.0.0.1" >/dev/null 2>&1 || true
	rm -f "$DIR/ssh.sock"
}

ssh_ready() {
	ssh_opts
	"${SSH[@]}" -o ConnectTimeout=3 "$VMUSER@127.0.0.1" exit </dev/null >/dev/null 2>&1
}

wait_ssh() { # таймаут в секундах
	local t=${1:-180}
	[[ ${ARCH:-amd64} == arm64 ]] && t=$((t * 4)) # эмуляция: загрузка в разы дольше
	local deadline=$((SECONDS + t))
	until ssh_ready; do
		is_running || die "VM '$NAME' остановилась (lsw logs $NAME)"
		((SECONDS < deadline)) || return 1
		sleep 2
	done
}

# ---------- образы ----------

distro_url() { # distro [amd64|arm64]
	local a=${2:-amd64}
	case $1 in
	ubuntu | ubuntu-26.04) echo "https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-$a.img" ;;
	ubuntu-24.04) echo "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-$a.img" ;;
	ubuntu-22.04) echo "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-$a.img" ;;
	arch) [[ $a == amd64 ]] || return 1; echo https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2 ;;
	*) return 1 ;;
	esac
}

pull_image() { # distro [force] [arch]
	local url f a=${3:-amd64}
	url=$(distro_url "$1" "$a") || die "неизвестный дистрибутив: $1 (ubuntu, ubuntu-24.04, ubuntu-22.04, arch, windows)"
	f=$CACHE/$1.img
	[[ $a == amd64 ]] || f=$CACHE/$1-$a.img
	if [[ ! -f $f || ${2:-} == force ]]; then
		mkdir -p "$CACHE"
		info "скачиваю $1: $url"
		curl -fL --progress-bar -o "$f.part" "$url" || die "не удалось скачать образ"
		mv "$f.part" "$f"
	fi
	echo "$f"
}

img_format() { qemu-img info "$1" | awk -F': ' '/^file format/ {print $2}'; }

mkiso() { # dir out label
	xorriso -as mkisofs -o "$2" -V "$3" -J -r "$1" >/dev/null 2>&1 || die "xorriso не смог собрать $2"
}

# ---------- Linux-гость ----------

cloud_body() { # cloud-config гостя без заголовка
	local pass
	pass=$(<"$DIR/password")
	cat <<EOF
hostname: $NAME
users:
  - name: $VMUSER
    gecos: $VMUSER
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: '$pass'
    ssh_authorized_keys:
      - $(<"$KEY.pub")
ssh_pwauth: false
growpart: {mode: auto, devices: ['/']}
EOF
	# в cloud-образе Ubuntu пустые списки apt; на Arch не делаем -Sy (частичное обновление)
	if [[ $DISTRO == ubuntu* ]]; then echo 'package_update: true'; fi
	# запись в fstab есть всегда (nofail): папку можно включить позже через lsw share
	cat <<'EOF'
runcmd:
  - mkdir -p /mnt/host
  - grep -q ' /mnt/host ' /etc/fstab || echo 'host /mnt/host virtiofs defaults,nofail 0 0' >> /etc/fstab
  - mount /mnt/host || true
EOF
}

write_seed() { # user-data-файл -> seed.iso (метка cidata)
	local d=$DIR/seed
	rm -rf "$d" && mkdir -p "$d"
	printf 'instance-id: %s\nlocal-hostname: %s\n' "$NAME-$(date +%s)" "$NAME" >"$d/meta-data"
	cat >"$d/user-data"
	mkiso "$d" "$DIR/seed.iso" cidata
}

make_seed() {
	{ echo '#cloud-config'; cloud_body; } | write_seed
}

# Ubuntu Server ISO: subiquity autoinstall; cloud_body уходит в установленную систему
make_autoinstall_seed() {
	{
		cat <<'EOF'
#cloud-config
autoinstall:
  version: 1
  refresh-installer: {update: false}
  locale: en_US.UTF-8
  keyboard: {layout: us}
  storage: {layout: {name: direct}}
  ssh: {install-server: true, allow-pw: false}
  late-commands:
    - sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty0 console=ttyS0,115200"/' /target/etc/default/grub
    - curtin in-target -- update-grub
  shutdown: poweroff
  user-data:
EOF
		cloud_body | sed 's/^/    /'
	} | write_seed
}

ubuntu_iso_info() { # iso -> версия (24.04), только для Server ISO
	local tmp info ver
	tmp=$(mktemp -d)
	xorriso -osirrox on -indev "$1" -extract /.disk/info "$tmp/info" >/dev/null 2>&1 || true
	info=$(cat "$tmp/info" 2>/dev/null || true)
	rm -rf "$tmp"
	[[ -n $info ]] || die "$1 не похож на ISO Ubuntu (нет .disk/info)"
	[[ $info == *Server* ]] || die "это не Server ISO ($info). Desktop ISO нельзя поставить без экрана — нужен *-live-server-amd64.iso"
	ver=$(grep -oE '[0-9]{2}\.[0-9]{2}' <<<"$info" | head -1)
	echo "${ver:-iso}"
}

extract_kernel() { # iso -> $DIR/boot/{vmlinuz,initrd}
	mkdir -p "$DIR/boot"
	xorriso -osirrox on -indev "$1" -extract /casper/vmlinuz "$DIR/boot/vmlinuz" \
		-extract /casper/initrd "$DIR/boot/initrd" >/dev/null 2>&1 ||
		die "не нашёл /casper/vmlinuz и initrd в ISO"
	chmod u+w "$DIR/boot"/*
}

start_virtiofsd() {
	local bin lim ro=()
	bin=$(find_virtiofsd) || die "virtiofsd не найден (выключи общую папку: lsw share $NAME off)"
	[[ -d $SHARE ]] || die "папка для общего доступа не существует: $SHARE (lsw share $NAME off)"
	if [[ ${SHARE_RO:-0} == 1 ]]; then
		"$bin" --help 2>&1 | grep -q -- --readonly || die "этот virtiofsd не умеет --readonly (нужен 1.11+)"
		ro=(--readonly)
	fi
	rm -f "$DIR/vfs.sock"
	lim=$(ulimit -Hn)
	[[ $lim =~ ^[0-9]+$ ]] || lim=1048576
	setsid "$bin" --socket-path="$DIR/vfs.sock" --shared-dir="$SHARE" \
		--sandbox=none --cache=auto --rlimit-nofile="$lim" "${ro[@]}" \
		>"$DIR/virtiofsd.log" 2>&1 </dev/null &
	echo $! >"$DIR/virtiofsd.pid"
	local i
	for i in {1..50}; do
		[[ -S $DIR/vfs.sock ]] && return
		sleep 0.1
	done
	die "virtiofsd не запустился: $(tail -3 "$DIR/virtiofsd.log")"
}

# Кэш диска: writeback + io_uring (где io_uring выключен sysctl — потоки). cache=none (O_DIRECT)
# не берём: на btrfs со сжатием/CoW он в разы медленнее на последовательном вводе-выводе.
# Переопределить: LSW_DISK_CACHE="cache=none,aio=native" (ext4/xfs, btrfs с chattr +C)
disk_cache() {
	if [[ -n ${LSW_DISK_CACHE:-} ]]; then echo "$LSW_DISK_CACHE"; return; fi
	if [[ $(cat /proc/sys/kernel/io_uring_disabled 2>/dev/null || echo 0) == 0 ]]; then
		echo "cache=writeback,aio=io_uring"
	else
		echo "cache=writeback,aio=threads"
	fi
}

linux_args() {
	# arm64 (TCG): pauth-impdef — быстрая эмуляция pointer authentication
	[[ $ARCH == arm64 ]] && ARGS+=(-cpu "${LSW_ARM_CPU:-max,pauth-impdef=on}") || ARGS+=(-cpu host)
	ARGS+=(
		# отдельный iothread: ввод-вывод диска не стоит в очереди за vCPU и эмуляцией устройств
		-object iothread,id=io0
		-drive "file=$DIR/disk.qcow2,if=none,id=d0,$(disk_cache),discard=unmap,detect-zeroes=unmap"
		-device virtio-blk-pci,drive=d0,iothread=io0,bootindex=0
		-drive "file=$DIR/seed.iso,if=virtio,format=raw,readonly=on"
		-netdev "user,id=n0,hostfwd=tcp:127.0.0.1:$PORT-:22$(net_fwds)"
		-device virtio-net-pci,netdev=n0
		-device virtio-balloon-pci,free-page-reporting=on
		-device virtio-rng-pci
		-vga none)
	if [[ -n ${ISO:-} && $INSTALLED != 1 ]]; then # установщик Ubuntu Server
		ARGS+=(-cdrom "$ISO" -kernel "$DIR/boot/vmlinuz" -initrd "$DIR/boot/initrd"
			-append "autoinstall ds=nocloud console=ttyS0,115200" -no-reboot)
	elif [[ -n $SHARE ]]; then
		start_virtiofsd
		ARGS+=(-object "memory-backend-memfd,id=mem,size=$MEM,share=on" -numa node,memdev=mem
			-chardev "socket,id=vfs,path=$DIR/vfs.sock"
			-device vhost-user-fs-pci,chardev=vfs,tag=host)
	fi
}

# ---------- Windows-гость ----------

# ISO Windows — UDF: в ISO9660-части только README.TXT, xorriso их не читает, нужен 7z
find_7z() { command -v 7z 2>/dev/null || command -v 7zz 2>/dev/null || command -v 7za 2>/dev/null; }

win_lang() { # iso -> en-US / ru-RU / ...
	local iso=$1 lang='' z tmp
	if z=$(find_7z); then
		lang=$("$z" e -so "$iso" sources/lang.ini 2>/dev/null |
			awk -F= '/^\[Available UI Languages\]/ {f=1; next} /^\[/ {f=0} f && NF==2 {gsub(/[ \t\r]/, "", $1); print $1; exit}' || true)
	fi
	if [[ -z $lang ]]; then # по имени файла: ru_windows_10_..., Win10_22H2_Russian_x64.iso
		local f=${iso##*/}
		f=${f,,}
		case $f in
		ru_* | *russian*) lang=ru-RU ;;
		uk_* | *ukrainian*) lang=uk-UA ;;
		en-gb_* | *englishinternational*) lang=en-GB ;;
		de_* | *german*) lang=de-DE ;;
		fr_* | *french*) lang=fr-FR ;;
		es_* | *spanish*) lang=es-ES ;;
		it_* | *italian*) lang=it-IT ;;
		pl_* | *polish*) lang=pl-PL ;;
		*) lang=en-US ;;
		esac
		warn "язык ISO не прочитан (нет 7z) — по имени файла: $lang. Если не так: --lang ru-RU"
	fi
	echo "$lang"
}

win_check_iso() {
	local z
	if z=$(find_7z); then
		local list
		list=$("$z" l -ba "$1" 2>&1 || true)
		grep -qiE 'sources[/\\]install\.(wim|esd|swm)' <<<"$list" || {
			printf '%s\n' "$list" | head -15 >&2
			die "$1: $z не нашёл в ISO sources/install.wim|esd (выше — что он видит). Размер файла: $(du -h "$1" | cut -f1)"
		}
	else
		warn "7z не установлен — не могу заглянуть внутрь ISO (UDF), проверку пропускаю"
		warn "  лучше поставить: sudo pacman -S 7zip  /  sudo apt install 7zip"
	fi
}

openssh_msi() {
	local f=$CACHE/OpenSSH-Win64.msi url
	if [[ ! -f $f ]]; then
		url=$(curl -fsSL https://api.github.com/repos/PowerShell/Win32-OpenSSH/releases/latest |
			grep -o 'https://[^"]*OpenSSH-Win64[^"]*\.msi' | head -1 || true)
		if [[ -n $url ]]; then
			info "скачиваю Win32-OpenSSH: $url"
			mkdir -p "$CACHE"
			curl -fL --progress-bar -o "$f.part" "$url" && mv "$f.part" "$f" || rm -f "$f.part"
		fi
	fi
	[[ -f $f ]] && echo "$f" || true
}

make_win_cfg() { # iso lang key edition
	local d=$DIR/wincfg lang=$2 key=$3 edition=$4 pass msi input from=''
	pass=$(<"$DIR/password")
	rm -rf "$d" && mkdir -p "$d"
	cp "$KEY.pub" "$d/authorized_keys"
	msi=$(openssh_msi)
	if [[ -n $msi ]]; then cp "$msi" "$d/OpenSSH-Win64.msi"; else warn "MSI OpenSSH не скачан — гость поставит его из Windows Update"; fi
	[[ $lang == en-US ]] && input=en-US || input="$lang;en-US"
	[[ -n $edition ]] && from="<InstallFrom><MetaData wcm:action=\"add\"><Key>/IMAGE/INDEX</Key><Value>$edition</Value></MetaData></InstallFrom>"

	local intl="<InputLocale>$input</InputLocale><SystemLocale>$lang</SystemLocale><UILanguage>$lang</UILanguage><UserLocale>$lang</UserLocale>"
	local comp='processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS"'
	cat >"$d/autounattend.xml" <<EOF
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" $comp>
      <SetupUILanguage><UILanguage>$lang</UILanguage></SetupUILanguage>
      $intl
    </component>
    <component name="Microsoft-Windows-Setup" $comp>
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
