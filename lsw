ubuntu_iso_info() { # iso -> версия (24.04), только для Server ISO
	local tmp info ver
	tmp=$(mktemp -d)
	xorriso -osirrox on -indev "$1" -extract /.disk/info "$tmp/info" >/dev/null 2>&1 || true
	info=$(cat "$tmp/info" 2>/dev/null || true)
	rm -rf "$tmp"
	[[ -n $info ]] || die "$1 не похож на ISO Ubuntu (нет .disk/info)"
	[[ $info == *Server* ]] || die "это не Server ISO ($info). Desktop ISO нельзя поставить без экрана — нужен *-live-server-amd64.iso"
	ver=$(grep -oE '[0-9]{2}\.[0-9]{2}' <<<"$info" | head -1)
	echo "${ver:-iso}"
}

extract_kernel() { # iso -> $DIR/boot/{vmlinuz,initrd}
	mkdir -p "$DIR/boot"
	xorriso -osirrox on -indev "$1" -extract /casper/vmlinuz "$DIR/boot/vmlinuz" \
		-extract /casper/initrd "$DIR/boot/initrd" >/dev/null 2>&1 ||
		die "не нашёл /casper/vmlinuz и initrd в ISO"
	chmod u+w "$DIR/boot"/*
}

start_virtiofsd() {
	local bin lim ro=()
	ensure_virtiofsd || true
	bin=$(find_virtiofsd) || die "virtiofsd не найден (выключи общую папку: lsw share $NAME off)"
	[[ -d $SHARE ]] || die "папка для общего доступа не существует: $SHARE (lsw share $NAME off)"
	if [[ ${SHARE_RO:-0} == 1 ]]; then
		"$bin" --help 2>&1 | grep -q -- --readonly || die "этот virtiofsd не умеет --readonly (нужен 1.11+)"
		ro=(--readonly)
	fi
	rm -f "$DIR/vfs.sock"
	lim=$(ulimit -Hn)
	[[ $lim =~ ^[0-9]+$ ]] || lim=1048576
	setsid "$bin" --socket-path="$DIR/vfs.sock" --shared-dir="$SHARE" \
		--sandbox=none --cache=auto --rlimit-nofile="$lim" "${ro[@]}" \
		>"$DIR/virtiofsd.log" 2>&1 </dev/null &
	echo $! >"$DIR/virtiofsd.pid"
	local i
	for i in {1..50}; do
		[[ -S $DIR/vfs.sock ]] && return
		sleep 0.1
	done
	die "virtiofsd не запустился: $(tail -3 "$DIR/virtiofsd.log")"
}

# Кэш диска: writeback + io_uring (где io_uring выключен sysctl — потоки). cache=none (O_DIRECT)
# не берём: на btrfs со сжатием/CoW он в разы медленнее на последовательном вводе-выводе.
# Переопределить: LSW_DISK_CACHE="cache=none,aio=native" (ext4/xfs, btrfs с chattr +C)
disk_cache() {
	if [[ -n ${LSW_DISK_CACHE:-} ]]; then echo "$LSW_DISK_CACHE"; return; fi
	if [[ $(cat /proc/sys/kernel/io_uring_disabled 2>/dev/null || echo 0) == 0 ]]; then
		echo "cache=writeback,aio=io_uring"
	else
		echo "cache=writeback,aio=threads"
	fi
}

linux_args() {
	# arm64 (TCG): pauth-impdef — быстрая эмуляция pointer authentication
	[[ $ARCH == arm64 ]] && ARGS+=(-cpu "${LSW_ARM_CPU:-max,pauth-impdef=on}") || ARGS+=(-cpu host)
	ARGS+=(
		# отдельный iothread: ввод-вывод диска не стоит в очереди за vCPU и эмуляцией устройств
		-object iothread,id=io0
		-drive "file=$DIR/disk.qcow2,if=none,id=d0,$(disk_cache),discard=unmap,detect-zeroes=unmap"
		-device virtio-blk-pci,drive=d0,iothread=io0,bootindex=0
		-drive "file=$DIR/seed.iso,if=virtio,format=raw,readonly=on"
		-netdev "user,id=n0,hostfwd=tcp:127.0.0.1:$PORT-:22$(net_fwds)"
		-device virtio-net-pci,netdev=n0
		-device virtio-balloon-pci,free-page-reporting=on
		-device virtio-rng-pci
		-vga none)
	if [[ -n ${ISO:-} && $INSTALLED != 1 ]]; then # установщик Ubuntu Server
		ARGS+=(-cdrom "$ISO" -kernel "$DIR/boot/vmlinuz" -initrd "$DIR/boot/initrd"
			-append "autoinstall ds=nocloud console=ttyS0,115200" -no-reboot)
	elif [[ -n $SHARE ]]; then
		start_virtiofsd
		ARGS+=(-object "memory-backend-memfd,id=mem,size=$MEM,share=on" -numa node,memdev=mem
			-chardev "socket,id=vfs,path=$DIR/vfs.sock"
			-device vhost-user-fs-pci,chardev=vfs,tag=host)
	fi
}

# ---------- Windows-гость ----------

# ISO Windows — UDF: в ISO9660-части только README.TXT, xorriso их не читает, нужен 7z
find_7z() { command -v 7z 2>/dev/null || command -v 7zz 2>/dev/null || command -v 7za 2>/dev/null; }

win_lang() { # iso -> en-US / ru-RU / ...
	local iso=$1 lang='' z tmp
	if z=$(find_7z); then
		lang=$("$z" e -so "$iso" sources/lang.ini 2>/dev/null |
			awk -F= '/^\[Available UI Languages\]/ {f=1; next} /^\[/ {f=0} f && NF==2 {gsub(/[ \t\r]/, "", $1); print $1; exit}' || true)
	fi
	if [[ -z $lang ]]; then # по имени файла: ru_windows_10_..., Win10_22H2_Russian_x64.iso
		local f=${iso##*/}
		f=${f,,}
		case $f in
		ru_* | *russian*) lang=ru-RU ;;
		uk_* | *ukrainian*) lang=uk-UA ;;
		en-gb_* | *englishinternational*) lang=en-GB ;;
		de_* | *german*) lang=de-DE ;;
		fr_* | *french*) lang=fr-FR ;;
		es_* | *spanish*) lang=es-ES ;;
		it_* | *italian*) lang=it-IT ;;
		pl_* | *polish*) lang=pl-PL ;;
		*) lang=en-US ;;
		esac
		warn "язык ISO не прочитан (нет 7z) — по имени файла: $lang. Если не так: --lang ru-RU"
	fi
	echo "$lang"
}

win_check_iso() {
	local z
	if z=$(find_7z); then
		local list
		list=$("$z" l -ba "$1" 2>&1 || true)
		grep -qiE 'sources[/\\]install\.(wim|esd|swm)' <<<"$list" || {
			printf '%s\n' "$list" | head -15 >&2
			die "$1: $z не нашёл в ISO sources/install.wim|esd (выше — что он видит). Размер файла: $(du -h "$1" | cut -f1)"
		}
	else
		warn "7z не установлен — не могу заглянуть внутрь ISO (UDF), проверку пропускаю"
		warn "  лучше поставить: sudo pacman -S 7zip  /  sudo apt install 7zip"
	fi
}

openssh_msi() {
	local f=$CACHE/OpenSSH-Win64.msi url
	if [[ ! -f $f ]]; then
		url=$(curl -fsSL https://api.github.com/repos/PowerShell/Win32-OpenSSH/releases/latest |
			grep -o 'https://[^"]*OpenSSH-Win64[^"]*\.msi' | head -1 || true)
		if [[ -n $url ]]; then
			info "скачиваю Win32-OpenSSH: $url"
			mkdir -p "$CACHE"
			curl -fL --progress-bar -o "$f.part" "$url" && mv "$f.part" "$f" || rm -f "$f.part"
		fi
	fi
	[[ -f $f ]] && echo "$f" || true
}

