windows_args() {
	local net="user,id=n0,hostfwd=tcp:127.0.0.1:$PORT-:22$(net_fwds)"
	if [[ -n $SHARE ]]; then # в Windows: \\10.0.2.4\qemu (QEMU сам запускает smbd от пользователя)
		if command -v smbd >/dev/null || [[ -x /usr/sbin/smbd ]]; then
			net+=",smb=$SHARE"
		else
			warn "общая папка для Windows требует samba на хосте: sudo apt install samba / sudo pacman -S samba"
		fi
	fi
	ARGS+=(-cpu "${LSW_WIN_CPU:-host,hv_relaxed,hv_spinlocks=0x1fff,hv_vapic,hv_time,hv_vpindex,hv_synic,hv_stimer}"
		-rtc base=localtime
		-drive "file=$DIR/disk.qcow2,if=none,id=d0,$(disk_cache),discard=unmap,detect-zeroes=unmap" -device ide-hd,drive=d0,bus=ide.0
		-netdev "$net" -device e1000e,netdev=n0
		-vga std)
	if [[ $INSTALLED != 1 ]]; then
		ARGS+=(-drive "file=$ISO,if=none,id=cd0,media=cdrom,readonly=on" -device ide-cd,drive=cd0,bus=ide.1
			-drive "file=$DIR/wincfg.iso,if=none,id=cd1,media=cdrom,readonly=on" -device ide-cd,drive=cd1,bus=ide.2
			-boot order=c,once=d)
	fi
}

# ---------- запуск / остановка ----------

kvm_check() { # /dev/kvm доступен? иначе — понятная причина
	[[ -w /dev/kvm ]] && return
	[[ -e /dev/kvm ]] || die "нет /dev/kvm: включи виртуализацию (VT-x/AMD-V) в BIOS; в облачной VM нужна nested virtualization"
	if id -nG "$USER" 2>/dev/null | grep -qw kvm || getent group kvm | grep -qE "[:,]$USER(,|$)"; then
		die "нет доступа к /dev/kvm: группа kvm добавлена, но сессия старая — перелогинься (или выполни: newgrp kvm)"
	fi
	die "нет доступа к /dev/kvm: sudo usermod -aG kvm $USER, затем перелогинься"
}

vm_start() {
	is_running && return
	rm -f "$DIR"/{qmp,console,ssh}.sock "$DIR/mounted"
	local mem=$MEM
	if [[ $TYPE == linux && -n ${ISO:-} && $INSTALLED != 1 ]] && (($(mem_mb "$MEM") < 4096)); then mem=4G; fi
	if [[ $ARCH == arm64 ]]; then # KVM для ARM на x86 нет — программная эмуляция (многопоточный TCG)
		local fw
		command -v qemu-system-aarch64 >/dev/null || die "нет qemu-system-aarch64: sudo pacman -S qemu-system-aarch64 / sudo apt install qemu-system-arm"
		fw=$(find_aavmf) || die "нет UEFI для arm64: sudo pacman -S edk2-aarch64 / sudo apt install qemu-efi-aarch64"
		ARGS=(qemu-system-aarch64 -name "$NAME" -machine virt -accel tcg,thread=multi,tb-size=512 -bios "$fw")
	else
		kvm_check
		ARGS=(qemu-system-x86_64 -name "$NAME" -machine q35,accel=kvm)
	fi
	ARGS+=(-smp "$CPUS" -m "$mem"
		-chardev "socket,id=con,path=$DIR/console.sock,server=on,wait=off,logfile=$DIR/console.log,logappend=on"
		-serial chardev:con
		-qmp "unix:$DIR/qmp.sock,server=on,wait=off"
		-pidfile "$DIR/qemu.pid" -daemonize)
	if [[ ${VNC:-} ]]; then ARGS+=(-vnc "127.0.0.1:$VNC"); else ARGS+=(-display none); fi
	case $TYPE in
	linux) linux_args ;;
	windows) windows_args ;;
	esac
	info "запускаю $NAME"
	"${ARGS[@]}" 2>"$DIR/qemu.log" || { stop_virtiofsd; die "QEMU не стартовал: $(tail -5 "$DIR/qemu.log")"; }
}

mem_mb() { # 2G / 2048M / 2048 -> МБ
	local v=${1^^}
	case $v in
	*G) echo $((${v%G} * 1024)) ;;
	*M) echo "${v%M}" ;;
	*) echo "$v" ;;
	esac
}

stop_virtiofsd() {
	[[ -f $DIR/virtiofsd.pid ]] && kill "$(<"$DIR/virtiofsd.pid")" 2>/dev/null || true
	rm -f "$DIR/virtiofsd.pid" "$DIR/vfs.sock"
}

qmp_raw() { # JSON-команда -> строка ответа QMP ({"return":...} или {"error":...})
	printf '{"execute":"qmp_capabilities"}\n%s\n' "$1" |
		socat -t2 - "UNIX-CONNECT:$DIR/qmp.sock" 2>/dev/null | grep -E '"(return|error)"' | tail -1
}

qmp() { qmp_raw "{\"execute\":\"$1\"}" >/dev/null || true; }

qmp_ok() { # JSON-команда; при ошибке печатает её текст
	local r
	r=$(qmp_raw "$1" || true)
	[[ $r == *'"return"'* ]] && return 0
	r=${r#*\"desc\": \"}
	echo "${r%%\"*}"
	return 1
}

qmp_hmp() { # команда монитора QEMU (hostfwd_add ...); успех = пустой ответ
	local r
	r=$(qmp_raw "{\"execute\":\"human-monitor-command\",\"arguments\":{\"command-line\":\"$1\"}}" || true)
	[[ $r =~ \"return\":\ *\"(\\r\\n)?\" ]] && return 0
	r=${r#*\"return\": \"}
	r=${r%\"*}
	echo "${r//\\r\\n/ }"
	return 1
}

vm_stop() { # [kill] — сразу, без выключения гостя (VM всё равно удаляется)
	local pid i n=90
	pid=$(qemu_pid) || { stop_virtiofsd; return 0; }
	info "останавливаю $NAME"
	if [[ ${1:-} == kill ]]; then n=0; else qmp system_powerdown; fi
	for ((i = 0; i < n; i++)); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 1
	done
	if kill -0 "$pid" 2>/dev/null; then
		((n)) && warn "гость не выключился за 90 с — выключаю принудительно"
		qmp quit
		for i in {1..20}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
		kill "$pid" 2>/dev/null || true
	fi
	ssh_close
	stop_virtiofsd
	rm -f "$DIR"/{qemu.pid,mounted}
}

# VM, созданные без общей папки, не имеют записи в fstab — дописываем и монтируем
ensure_mount() {
	[[ $TYPE == linux && -n $SHARE ]] || return 0
	local link
	link=$(basename "$SHARE")
	ssh_opts
	# плюс ссылка ~/<имя папки> -> /mnt/host, чтобы папку было видно сразу в домашнем каталоге
	"${SSH[@]}" "$VMUSER@127.0.0.1" "link=$(printf %q "$link")"'
if ! mountpoint -q /mnt/host; then
	sudo mkdir -p /mnt/host
	grep -q " /mnt/host " /etc/fstab || echo "host /mnt/host virtiofs defaults,nofail 0 0" | sudo tee -a /etc/fstab >/dev/null
	sudo mount /mnt/host || exit 1
fi
for l in ~/* ~/.[!.]*; do
	[ -L "$l" ] && [ "$(readlink "$l")" = /mnt/host ] && [ "$l" != ~/"$link" ] && rm -f "$l"
done
[ -e ~/"$link" ] || [ -L ~/"$link" ] || ln -s /mnt/host ~/"$link"
exit 0' </dev/null >/dev/null 2>&1 && : >"$DIR/mounted" ||
		warn "общая папка не смонтировалась — перезапусти VM: lsw restart $NAME"
}

ensure_up() { # запустить при необходимости и дождаться ssh
	[[ $INSTALLED == 1 ]] || die "'$NAME' ещё устанавливается (lsw list, lsw logs $NAME)"
	if ! is_running; then vm_start; fi
	if ! ssh_ready; then
		printf '\e[2m... жду %s\e[0m\n' "$NAME" >&2
		wait_ssh 180 || die "ssh в '$NAME' не поднялся (lsw console $NAME)"
	fi
	# монтирование проверяем раз за загрузку, а не перед каждой командой
	[[ -f $DIR/mounted ]] || ensure_mount
	[[ ${GROW:-0} != 1 ]] || grow_guest
}

# ---------- команды ----------

guest_user() { # имя -> допустимое имя пользователя гостя
	# доменные логины (ivan@corp.ru, CORP\Ivan) useradd в Arch и Windows не примет — берём короткое имя
	local u=${1%%@*}
	u=${u##*\\}
	u=${u,,}
	u=${u//[^a-z0-9._-]/-}
	[[ $u =~ [a-z0-9] ]] || u='' # не латиница (Иван) — общее имя
	[[ -z $u || $u == [a-z_]* ]] || u=u$u
	u=${u:0:32}
	[[ -z $u || $u == root ]] && u=user
	echo "$u"
}

cmd_install() {
	local distro=${1:-}
	[[ -n $distro ]] || die "lsw install <ubuntu|ubuntu-24.04|arch|windows> [имя]"
	shift
	local name='' cpus='' mem='' disk='' share='' share_ro=0 pass='' user=${LSW_USER:-$USER} iso='' key=$WIN_GENERIC_KEY edition='' vnc='' lang='' arch=amd64
	if [[ ${1:-} && $1 != -* ]]; then name=$1; shift; fi
	while (($#)); do
		case $1 in
		--cpus) cpus=$2; shift ;;
		--mem) mem=$2; shift ;;
		--disk) disk=$2; shift ;;
		--share) parse_share "$2"; share=$PSHARE share_ro=$PSHARE_RO; shift ;;
		--no-share) share='' ;;
		--password) pass=$2; shift ;;
		--user) user=$2; shift ;;
		--iso) iso=$(realpath "$2"); shift ;;
		--key) key=$2; shift ;;
		--edition) edition=$2; shift ;;
		--lang) lang=$2; shift ;;
		--arch)
			case $2 in amd64 | x86_64) arch=amd64 ;; arm64 | aarch64) arch=arm64 ;; *) die "--arch: amd64 или arm64" ;; esac
			shift ;;
		--vnc) vnc=1 ;;
		*) die "неизвестная опция: $1" ;;
		esac
		shift
	done
	user=$(guest_user "$user")
	[[ -n $pass ]] || pass=$user
	cmd_deps quiet
	ensure_key
	[[ $arch == arm64 ]] || kvm_check
	if [[ $arch == arm64 ]]; then
		[[ $distro == ubuntu* && -z $iso ]] || die "--arch arm64 поддерживается только для ubuntu из cloud-образа (без --iso)"
		find_aarch64 >/dev/null || die "для arm64 нужны qemu-system-aarch64 и UEFI: sudo pacman -S qemu-system-aarch64 edk2-aarch64 / sudo apt install qemu-system-arm qemu-efi-aarch64"
	fi

	local type=linux
	if [[ $distro == windows ]]; then
		type=windows
		[[ -n $iso && -f $iso ]] || die "для Windows нужен --iso путь/к/Win10.iso"
		win_check_iso "$iso"
	else
		distro_url "$distro" >/dev/null || die "неизвестный дистрибутив: $distro"
		if [[ -n $iso ]]; then
			[[ $distro == ubuntu* ]] || die "--iso для Linux поддерживается только для Ubuntu Server"
			[[ -f $iso ]] || die "нет файла $iso"
			local ver
			ver=$(ubuntu_iso_info "$iso")
			distro=ubuntu-$ver
			name=${name:-ubuntu-${ver//./}}
		fi
	fi
	name=${name:-$distro}
	[[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "имя: только a-z, 0-9 и '-'"
	[[ ! -e $(vm_dir "$name") ]] || die "VM '$name' уже есть"
	if [[ $type == windows ]]; then
		: "${cpus:=4}" "${mem:=4G}" "${disk:=64G}"
	else
		: "${cpus:=2}" "${mem:=2G}" "${disk:=20G}"
	fi

	NAME=$name DIR=$(vm_dir "$name")
	mkdir -p "$DIR"
	# до первого успешного запуска VM недоделана: при ошибке убираем её, чтобы повтор не упёрся в «уже есть»
	trap 'rm -rf "$DIR"; [[ $(default_vm) == "$NAME" ]] && rm -f "$LSW_HOME/default"' EXIT
	printf '%s' "$pass" >"$DIR/password" && chmod 600 "$DIR/password"
	# порт резервируем сразу: параллельная установка (tui) не должна взять тот же
	{ flock 9; PORT=$(free_port); echo "$PORT" >"$DIR/port.reserve"; } 9>"$LSW_HOME/port.lock"
	TYPE=$type DISTRO=$distro ARCH=$arch CPUS=$cpus MEM=$mem VMUSER=$user SHARE=$share SHARE_RO=$share_ro ISO=$iso INSTALLED=0

	if [[ $type == linux && -n $iso ]]; then
		info "Ubuntu Server ISO ($distro), диск $disk"
		extract_kernel "$iso"
		qemu-img create -q -f qcow2 -o preallocation=metadata "$DIR/disk.qcow2" "$disk"
		make_autoinstall_seed
	elif [[ $type == linux ]]; then
		local base
		base=$(pull_image "$distro" '' "$arch")
		info "готовлю диск $disk"
		qemu-img convert -O qcow2 -o preallocation=metadata -f "$(img_format "$base")" "$base" "$DIR/disk.qcow2"
		qemu-img resize -q --preallocation=metadata "$DIR/disk.qcow2" "$disk"
		make_seed
	else
		[[ -n $lang ]] || lang=$(win_lang "$iso")
		info "Windows ISO: язык $lang"
		make_win_cfg "$iso" "$lang" "$key" "$edition"
		qemu-img create -q -f qcow2 -o preallocation=metadata "$DIR/disk.qcow2" "$disk"
	fi

	local v
	{
		for v in TYPE DISTRO ARCH CPUS MEM PORT VMUSER SHARE SHARE_RO ISO INSTALLED; do printf '%s=%q\n' "$v" "${!v}"; done
	} >"$DIR/vm.conf"
	rm -f "$DIR/port.reserve"
	[[ -n $(default_vm) ]] || echo "$name" >"$LSW_HOME/default"

	[[ -n $vnc ]] && VNC=$((PORT - 2222 + 10))
	vm_start
	trap - EXIT
	[[ -n $vnc ]] && info "VNC: 127.0.0.1:$((5900 + VNC))"

	if [[ $type == linux ]]; then
		if [[ -n $ISO ]]; then
			install_from_iso
			vm_start
		fi
		info "первая загрузка и cloud-init...$([[ $ARCH == arm64 ]] && echo ' (arm64 под эмуляцией: 5–15 минут)')"
		wait_boot 300 || die "гость не пустил по ssh за $([[ $ARCH == arm64 ]] && echo 20 || echo 5) мин. ssh: $(ssh_why). Консоль: $(console_line 200). Весь лог: lsw logs $name"
		info "ssh есть, жду конца cloud-init (пользователь, ключи, размер диска)"
		ssh_opts
		"${SSH[@]}" "$VMUSER@127.0.0.1" 'cloud-init status --wait >/dev/null 2>&1 || true'
	else
		info "установка Windows идёт без участия, обычно 15–40 минут (можно прервать Ctrl+C — VM продолжит работу)"
		trap 'echo; info "VM ставится в фоне. Проверить: lsw list; когда будет готово: lsw shell $NAME"; exit 0' INT
		local t0=$SECONDS
		until ssh_ready; do
			is_running || die "VM остановилась во время установки (попробуй --vnc, чтобы посмотреть экран)"
			printf '\r  %3d мин  диск: %s   ' $(((SECONDS - t0) / 60)) "$(du -h "$DIR/disk.qcow2" | cut -f1)" >&2
			sleep 10
		done
		echo >&2
		trap - INT
	fi
	conf_set INSTALLED 1
	info "готово: lsw shell $name   (пользователь $VMUSER, пароль в $DIR/password)"
}

console_line() { # [ширина] -> последняя осмысленная строка серийной консоли гостя
	# OSC/DCS (запросы терминала от systemd: ESC P…ESC \\, ESC ]…BEL), CSI, прочие ESC-пары
	tail -c 4096 "$DIR/console.log" 2>/dev/null | tr '\r' '\n' |
		LC_ALL=C sed -E 's/\x1b[]P_^][^\x07\x1b]*(\x07|\x1b\\)?//g; s/\x1b\[[0-9;?<=>]*[ -\/]*[@-~]//g; s/\x1b.//g; s/[[:cntrl:]]//g' |
		grep -E '[[:alnum:]]' | tail -1 | cut -c1-"${1:-60}" || true
}

wait_boot() { # таймаут — как wait_ssh, но с ходом загрузки: время и что гость пишет в консоль
	local t=$1 t0=$SECONDS deadline cols line login=0 why='' next=0
	[[ ${ARCH:-amd64} == arm64 ]] && t=$((t * 4))
	deadline=$((SECONDS + t))
	cols=$(( $(tput cols 2>/dev/null || echo 80) - 12 ))
	until ssh_ready; do
		is_running || { printf '\r\e[K' >&2; die "VM '$NAME' остановилась. Последнее в консоли: $(console_line 200) (lsw logs $NAME)"; }
		if ((SECONDS >= deadline)); then
			printf '\r\e[K' >&2
			return 1
		fi
		line=$(console_line "$cols")
		# гость уже ждёт входа (или грузится подозрительно долго), а ssh не пускает — показываем, что отвечает ssh
		[[ $line == *'login:'* ]] && ((login == 0)) && login=$SECONDS
		if (((login && SECONDS - login >= 30) || SECONDS - t0 >= 90)) && ((SECONDS >= next)); then
			why=$(ssh_why) next=$((SECONDS + 15))
		fi
		[[ -z $why ]] || line="ssh: $why"
		printf '\r\e[K  %d:%02d  %s' $(((SECONDS - t0) / 60)) $(((SECONDS - t0) % 60)) "${line:0:cols}" >&2
		sleep 2
	done
	printf '\r\e[K' >&2
}

# установщик сам выключает VM (shutdown: poweroff); показываем прогресс по серийной консоли
install_from_iso() {
	info "автоустановка Ubuntu Server, обычно 5–15 минут (Ctrl+C — прервать и удалить VM)"
	trap 'echo; qmp quit; sleep 1; rm -rf "$DIR"; [[ $(default_vm) == "$NAME" ]] && rm -f "$LSW_HOME/default"; die "установка прервана, VM удалена"' INT
	local t0=$SECONDS cols line
	cols=$(( $(tput cols 2>/dev/null || echo 80) - 22 ))
	while is_running; do
		line=$(console_line "$cols")
		printf '\r\e[K  %3d мин  %s' $(((SECONDS - t0) / 60)) "$line" >&2
		(((SECONDS - t0) < 3600)) || { echo >&2; qmp quit; die "установка идёт больше часа — смотри $DIR/console.log"; }
		sleep 3
	done
	printf '\r\e[K' >&2
	trap - INT
	rm -f "$DIR/qemu.pid"
	# дальше — обычная загрузка с диска, установщик больше не нужен
	conf_set ISO ''
	ISO=''
	rm -rf "$DIR/boot"
	make_seed
	info "установка завершена, загружаю систему"
}

cmd_list() {
	local d n def state
	def=$(default_vm)
	printf '%-2s%-16s %-13s %-12s %-5s %-5s %s\n' '' NAME TYPE STATE CPUS MEM PORT
	for d in "$VMS"/*/; do
		[[ -f $d/vm.conf ]] || continue
		n=$(basename "$d")
		(
			load_vm "$n"
			if is_running; then
				if [[ $INSTALLED == 1 ]]; then state=running; else state=installing; fi
			else state=stopped; fi
			printf '%-2s%-16s %-13s %-12s %-5s %-5s %s\n' "$([[ $n == "$def" ]] && echo '*')" "$n" "$DISTRO$([[ $ARCH == arm64 ]] && echo /arm64)" "$state" "$CPUS" "$MEM" "$PORT"
		)
	done
}

cmd_shell() {
	load_vm "$(resolve_name "${1:-}")"
	ensure_up
	ssh_opts
	if [[ $TYPE == linux ]]; then
		# как в WSL: открываемся в той же папке, если она внутри общей
		local rel='' cd=''
		if [[ -n $SHARE && ( $PWD == "$SHARE" || $PWD == "$SHARE"/* ) ]]; then
			rel=${PWD#"$SHARE"}
			cd="cd $(printf %q "/mnt/host$rel") 2>/dev/null;"
		fi
		exec "${SSH[@]}" -t "$VMUSER@127.0.0.1" "$cd exec \$SHELL -l"
	else
		exec "${SSH[@]}" -t "$VMUSER@127.0.0.1"
	fi
}

cmd_run() {
	local n=${1:-}
	[[ -n $n ]] || die "lsw run <имя> -- команда"
	shift
	[[ ${1:-} == -- ]] && shift
	(($#)) || cmd_shell "$n" # без команды — просто терминал
	load_vm "$n"
	ensure_up
	ssh_opts
	local tty=()
	[[ -t 0 && -t 1 ]] && tty=(-t)
	if [[ $TYPE == linux ]] && (($# > 1)); then
		exec "${SSH[@]}" "${tty[@]}" "$VMUSER@127.0.0.1" "$(printf '%q ' "$@")"
	elif [[ $TYPE == linux ]]; then
		# один аргумент — строка для шелла гостя, как в ssh/WSL: lsw run vm -- 'a; b | c'
		exec "${SSH[@]}" "${tty[@]}" "$VMUSER@127.0.0.1" "$1"
	else
		exec "${SSH[@]}" "${tty[@]}" "$VMUSER@127.0.0.1" "$*"
	fi
}

cmd_console() {
	load_vm "$(resolve_name "${1:-}")"
	is_running || die "'$NAME' не запущена"
	info "консоль $NAME — выход Ctrl+]"
	exec socat STDIO,rawer,escape=0x1d "UNIX-CONNECT:$DIR/console.sock"
}

cmd_ssh_config() {
	local d n
	ensure_key
	for d in "$VMS"/*/; do
		n=$(basename "$d")
		[[ -z ${1:-} || $1 == "$n" ]] || continue
		(
			load_vm "$n"
			printf 'Host lsw-%s\n  HostName 127.0.0.1\n  Port %s\n  User %s\n  IdentityFile %s\n  IdentitiesOnly yes\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n  LogLevel ERROR\n\n' \
				"$n" "$PORT" "$VMUSER" "$KEY"
		)
	done
}

parse_share() { # DIR[:ro] -> PSHARE, PSHARE_RO
	local spec=$1
	PSHARE_RO=0
	if [[ $spec == *:ro ]]; then spec=${spec%:ro}; PSHARE_RO=1; fi
	[[ -d $spec ]] || die "нет такой папки: $spec"
	PSHARE=$(realpath "$spec")
	[[ $PSHARE != / ]] || die "открывать гостю весь / — плохая идея"
}

cmd_share() { # [имя] [DIR[:ro]|off]
	local name=${1:-} spec=${2:-}
	# lsw share ~/dir — без имени берём VM по умолчанию
	if [[ $# == 1 && ! -f $(vm_dir "$name")/vm.conf ]] &&
		[[ $name == off || $name == */* || $name == . || $name == .. || -d ${name%:ro} ]]; then
		spec=$name name=''
	elif [[ $# == 1 && ! -f $(vm_dir "$name")/vm.conf ]]; then
		die "'$name' — нет ни такой VM, ни такой папки"
	fi
	load_vm "$(resolve_name "$name")"
	if [[ -z $spec ]]; then
		if [[ -z $SHARE ]]; then echo "$NAME: изолирована, общих папок нет"
		else echo "$NAME: $SHARE -> /mnt/host ($([[ ${SHARE_RO:-0} == 1 ]] && echo 'только чтение' || echo 'чтение и запись'))"; fi
		return
	fi
	[[ $TYPE == linux ]] || warn "для Windows папка работает только через samba (\\\\10.0.2.4\\qemu), только чтение не поддерживается"
	if [[ $spec == off ]]; then
		conf_set SHARE ''
		conf_set SHARE_RO 0
		info "$NAME: общая папка выключена"
	else
		parse_share "$spec"
		conf_set SHARE "$PSHARE"
		conf_set SHARE_RO "$PSHARE_RO"
		info "$NAME: $PSHARE -> ~/$(basename "$PSHARE") в госте (/mnt/host)$([[ $PSHARE_RO == 1 ]] && echo ', только чтение')"
	fi
	if offer_restart && is_running && [[ -n $SHARE ]]; then info "в госте: ~/$(basename "$SHARE") (= /mnt/host)"; fi
	return 0
}

offer_restart() { # применить изменения vm.conf к запущенной VM; 1 — отложено
	is_running || return 0
	if [[ -t 0 ]]; then
		local a
		read -rp "Перезапустить $NAME сейчас, чтобы применить? [Y/n] " a
		if [[ $a != [nNнН]* ]]; then
			vm_stop && vm_start && { wait_ssh 180 || warn "ssh пока не отвечает"; }
			ensure_mount
			return 0
		fi
	fi
	warn "применится после перезапуска: lsw restart $NAME"
	return 1
}

# ---------- ресурсы: lsw set ----------

disk_bytes() { # размер диска гостя (не файла: в JSON первым идёт узел file с длиной файла)
	local b
	b=$(qemu-img info -U "$DIR/disk.qcow2" | sed -n 's/^virtual size:.*(\([0-9]*\) bytes).*/\1/p')
	[[ $b =~ ^[0-9]+$ ]] && echo "$b"
}

human() { numfmt --to=iec-i --suffix=B "$1"; }

grow_guest() { # расширить последний раздел и ФС гостя до размера диска
	ssh_opts
	local cmd
	if [[ $TYPE == linux ]]; then # те же модули cloud-init, что расширяют диск при первой загрузке
		cmd='sudo cloud-init single --name growpart --frequency always && sudo cloud-init single --name resizefs --frequency always'
	else
		cmd='Update-HostStorageCache; $m = (Get-PartitionSupportedSize -DriveLetter C).SizeMax; if ($m -gt (Get-Partition -DriveLetter C).Size + 1MB) { Resize-Partition -DriveLetter C -Size $m -ErrorAction Stop }'
	fi
	if "${SSH[@]}" "$VMUSER@127.0.0.1" "$cmd" </dev/null >/dev/null 2>&1; then
		conf_set GROW 0
		info "$NAME: раздел гостя расширен до размера диска"
	else
		warn "не удалось расширить раздел в госте — попробую при следующем входе"
	fi
}

grow_disk() { # 40G | +10G
	local spec=${1^^} cur new err
	[[ $spec =~ ^\+?[1-9][0-9]*[MGT]$ ]] || die "--disk: размер вида 40G или +10G"
	cur=$(disk_bytes) || die "не прочитал размер диска"
	if [[ $spec == +* ]]; then new=$((cur + $(numfmt --from=iec "${spec#+}"))); else new=$(numfmt --from=iec "$spec"); fi
	((new > cur)) || die "диск можно только увеличить (сейчас $(human "$cur"))"
	((new > 0 && cur > 0)) || die "не прочитал размер диска"
	if is_running; then
		err=$(qmp_ok "{\"execute\":\"block_resize\",\"arguments\":{\"device\":\"d0\",\"size\":$new}}") ||
			die "QEMU не изменил размер диска: $err"
	else
		qemu-img resize -q "$DIR/disk.qcow2" "$new" || die "qemu-img resize не удался"
	fi
	conf_set GROW 1
	info "$NAME: диск $(human "$cur") → $(human "$new")"
	if is_running && ssh_ready; then grow_guest; fi
}

cmd_set() { # [имя] [--cpus N] [--mem 4G] [--disk 40G|+10G]
	local name='' cpus='' mem='' disk='' restart=0
	if (($#)) && [[ $1 != -* ]]; then name=$1; shift; fi
	load_vm "$(resolve_name "$name")"
	if ! (($#)); then
		printf '%s: %s CPU, %s RAM, диск %s (файл %s)\n' "$NAME" "$CPUS" "$MEM" \
			"$(human "$(disk_bytes)")" "$(du -h "$DIR/disk.qcow2" | cut -f1)"
		return
	fi
	while (($#)); do
		case $1 in
		--cpus) cpus=${2:?--cpus N}; shift ;;
		--mem) mem=${2:?--mem 4G}; shift ;;
		--disk) disk=${2:?--disk 40G}; shift ;;
		*) die "lsw set [имя] [--cpus N] [--mem 4G] [--disk 40G|+10G]" ;;
		esac
		shift
	done
	if [[ -n $cpus ]]; then
		[[ $cpus =~ ^[1-9][0-9]*$ ]] || die "--cpus: число"
		((cpus <= $(nproc))) || warn "у хоста всего $(nproc) потоков"
		[[ $cpus == "$CPUS" ]] || { conf_set CPUS "$cpus"; restart=1; }
	fi
	if [[ -n $mem ]]; then
		mem=${mem^^}
		[[ $mem =~ ^[1-9][0-9]*[MG]$ ]] || die "--mem: размер вида 4G или 4096M"
		(($(mem_mb "$mem") >= 512)) || die "--mem: минимум 512M"
		(($(mem_mb "$mem") * 1024 < $(awk '/^MemTotal/ {print $2}' /proc/meminfo))) || warn "это больше всей памяти хоста"
		[[ $mem == "$MEM" ]] || { conf_set MEM "$mem"; restart=1; }
	fi
	[[ -z $disk ]] || grow_disk "$disk"
	if ((restart)); then
		info "$NAME: $CPUS CPU, $MEM RAM"
		offer_restart || true
	fi
}

# ---------- проброс портов: lsw port ----------
# FWDS в vm.conf — через пробел: proto:адрес:порт_хоста:порт_гостя (tcp:127.0.0.1:8080:80)

net_fwds() { # -> ",hostfwd=...,hostfwd=..." для -netdev user
	local f p a h g out=''
	for f in ${FWDS:-}; do
		IFS=: read -r p a h g <<<"$f"
		out+=",hostfwd=$p:$a:$h-:$g"
	done
	echo "$out"
}

valid_port() { [[ $1 =~ ^[0-9]+$ ]] && (($1 >= 1 && $1 <= 65535)); }

parse_fwd() { # [АДРЕС:]ХОСТ[:ГОСТЬ][/udp] -> PFWD
	local s=$1 proto=tcp addr=127.0.0.1 h g p
	case $s in */udp) proto=udp s=${s%/udp} ;; */tcp) s=${s%/tcp} ;; esac
	IFS=: read -ra p <<<"$s"
	case ${#p[@]} in
	1) h=${p[0]} g=${p[0]} ;;
	2) h=${p[0]} g=${p[1]} ;;
	3) addr=${p[0]} h=${p[1]} g=${p[2]} ;;
	*) die "порт: 8080, 8080:80, 0.0.0.0:8080:80, 5353/udp" ;;
	esac
	[[ $addr == localhost ]] && addr=127.0.0.1
	[[ $addr =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "адрес хоста: IPv4, например 127.0.0.1 или 0.0.0.0"
	valid_port "$h" && valid_port "$g" || die "порт должен быть 1–65535: $1"
	PFWD=$proto:$addr:$h:$g
}

cmd_port() { # [имя] [list | [add] SPEC | rm ХОСТ[/udp]]
	local name='' op spec f p a h g
	if (($#)) && [[ -f $(vm_dir "$1")/vm.conf ]]; then name=$1; shift; fi
	load_vm "$(resolve_name "$name")"
	FWDS=${FWDS:-}
	op=${1:-list}
	case $op in
	list | ls)
		printf '  %-22s → %-5s %s\n' "127.0.0.1:$PORT" 22 ssh
		for f in $FWDS; do
			IFS=: read -r p a h g <<<"$f"
			printf '  %-22s → %-5s %s\n' "$a:$h" "$g" "$p"
		done
		;;
	rm | del | remove)
		spec=${2:?lsw port [имя] rm ПОРТ[/udp]}
		p=tcp
		[[ $spec == */udp ]] && p=udp
		spec=${spec%/*}
		spec=${spec##*:}
		local keep='' hit=''
		for f in $FWDS; do
			if [[ $f == "$p":*:"$spec":* ]]; then hit=$f; else keep+=" $f"; fi
		done
		[[ -n $hit ]] || die "$NAME: порт $spec/$p не проброшен (lsw port $NAME)"
		if is_running; then
			IFS=: read -r p a h g <<<"$hit"
			[[ $(qmp_hmp "hostfwd_remove n0 $p:$a:$h") == *removed* ]] || warn "QEMU не закрыл порт сразу — закроется после перезапуска"
		fi
		conf_set FWDS "${keep# }"
		info "$NAME: порт $spec/$p закрыт"
		;;
	*)
		[[ $op == add ]] && shift
		parse_fwd "${1:?lsw port [имя] ПОРТ[:ПОРТ_ГОСТЯ]}"
		IFS=: read -r p a h g <<<"$PFWD"
		for f in $FWDS; do
			[[ $f != "$p":*:"$h":* ]] || die "$NAME: порт $h/$p уже проброшен (lsw port $NAME rm $h)"
		done
		local owner
		owner=$(vm_host_ports | awk -v h="$h" '$1 == h && o == "" {o = $2} END {print o}')
		[[ -z $owner ]] || die "порт $h хоста уже занят VM '$owner'"
		local low
		low=$(cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null || echo 1024)
		((h >= low)) || die "порты хоста ниже $low открывает только root — возьми, например, $((h + 8000)):$g"
		if is_running; then
			local err
			err=$(qmp_hmp "hostfwd_add n0 $p:$a:$h-:$g") || die "QEMU не открыл порт $h: ${err:-занят?}"
		elif ss -Hl"$([[ $p == udp ]] && echo u || echo t)"n "sport = :$h" 2>/dev/null | grep -q .; then
			warn "порт $h на хосте сейчас занят — VM не запустится, пока его не освободят"
		fi
		conf_set FWDS "${FWDS:+$FWDS }$PFWD"
		info "$NAME: $a:$h → гость:$g ($p)"
		[[ $a != 0.0.0.0 ]] || warn "порт доступен всем в сети хоста, не только тебе"
		[[ $TYPE != windows ]] || warn "в Windows открой порт и в брандмауэре: New-NetFirewallRule -DisplayName lsw-$h -Direction Inbound -Protocol ${p^^} -LocalPort $g -Action Allow"
		;;
	esac
}

# ---------- снимки: lsw snapshot ----------

snap_tags() { qemu-img snapshot -l -U "$DIR/disk.qcow2" 2>/dev/null | awk 'NR > 2 {print $2}'; }

snap_exists() { snap_tags | grep -qxF -- "$1"; }

guest_sync() { # сбросить кеши гостя на диск перед снимком запущенной VM
	ssh_ready || return 0
	ssh_opts
	if [[ $TYPE == linux ]]; then
		timeout 60 "${SSH[@]}" "$VMUSER@127.0.0.1" sync </dev/null >/dev/null 2>&1 || true
	else
		timeout 60 "${SSH[@]}" "$VMUSER@127.0.0.1" 'Write-VolumeCache C' </dev/null >/dev/null 2>&1 || true
	fi
}

cmd_snapshot() { # [имя] [list|save [метка]|restore <метка> [-f]|rm <метка>]
	local name='' op tag err
	if (($#)) && [[ -f $(vm_dir "$1")/vm.conf ]]; then name=$1; shift; fi
	load_vm "$(resolve_name "$name")"
	[[ $INSTALLED == 1 ]] || die "'$NAME' ещё устанавливается"
	op=${1:-list} tag=${2:-}
	case $op in
	list | ls)
		local out
		out=$(qemu-img snapshot -l -U "$DIR/disk.qcow2" | awk 'NR > 2 {printf "  %-24s %s %s\n", $2, $5, substr($6, 1, 5)}')
		if [[ -z $out ]]; then echo "$NAME: снимков нет (lsw snapshot $NAME save)"; return; fi
		echo "$out"
		echo "  файл диска: $(du -h "$DIR/disk.qcow2" | cut -f1) — снимки держат старые данные, удаляй ненужные"
		;;
	save | create | new)
		tag=${tag:-$(date +%Y%m%d-%H%M%S)}
		[[ $tag =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "метка: буквы, цифры, . _ -"
		snap_exists "$tag" && die "снимок '$tag' уже есть"
		if is_running; then
			# диск без памяти: после restore гость загрузится как после выключения питания
			guest_sync
			err=$(qmp_ok "{\"execute\":\"blockdev-snapshot-internal-sync\",\"arguments\":{\"device\":\"d0\",\"name\":\"$tag\"}}") ||
				die "QEMU не сделал снимок: $err"
		else
			qemu-img snapshot -c "$tag" "$DIR/disk.qcow2" || die "qemu-img не сделал снимок"
		fi
		info "$NAME: снимок '$tag' (вернуть: lsw snapshot $NAME restore $tag)"
		;;
	restore | revert | apply)
		[[ -n $tag ]] || die "lsw snapshot $NAME restore <метка> (lsw snapshot $NAME)"
		snap_exists "$tag" || die "нет снимка '$tag' (lsw snapshot $NAME)"
		if [[ ${3:-} != -f ]]; then
			[[ -t 0 ]] || die "текущее состояние диска $NAME будет потеряно — подтверди: -f"
			local a
			read -rp "Вернуть $NAME к '$tag'? Всё, что изменилось после снимка, пропадёт. [y/N] " a
			[[ $a == [yYдД]* ]] || exit 1
		fi
		local was=0
		if is_running; then was=1; vm_stop; fi
		qemu-img snapshot -a "$tag" "$DIR/disk.qcow2" || die "qemu-img не применил снимок"
		info "$NAME: возвращена к '$tag'"
		if ((was)); then vm_start && { wait_ssh 180 || warn "ssh пока не отвечает"; }; fi
		;;
	rm | del | delete)
		[[ -n $tag ]] || die "lsw snapshot $NAME rm <метка>"
		snap_exists "$tag" || die "нет снимка '$tag'"
		if is_running; then
			err=$(qmp_ok "{\"execute\":\"blockdev-snapshot-delete-internal-sync\",\"arguments\":{\"device\":\"d0\",\"name\":\"$tag\"}}") ||
				die "QEMU не удалил снимок: $err"
		else
			qemu-img snapshot -d "$tag" "$DIR/disk.qcow2" || die "qemu-img не удалил снимок"
		fi
		info "$NAME: снимок '$tag' удалён"
		;;
	*) die "lsw snapshot [имя] [list|save [метка]|restore <метка>|rm <метка>]" ;;
	esac
}

cmd_rm() {
	local n=${1:-} force=${2:-}
	[[ -n $n ]] || die "lsw rm <имя>"
	load_vm "$n"
	if [[ $force != -f ]]; then
		read -rp "Удалить VM '$n' вместе с диском? [y/N] " a
		[[ $a == [yYдД]* ]] || exit 1
	fi
	vm_stop kill
	rm -rf "$DIR"
	[[ $(default_vm) == "$n" ]] && rm -f "$LSW_HOME/default"
	info "удалена: $n"
}

# ---------- обновление самого lsw ----------

newer() { [[ $1 != "$2" && $(printf '%s\n' "$1" "$2" | sort -V | tail -n1) == "$1" ]]; }

cmd_upgrade() { # [--check] [--from lsw-*.tar.gz]
	local self dir check='' from='' latest nv sudo=''
	self=$(readlink -f "$0") dir=$(dirname "$self")
	while (($#)); do
		case $1 in
		--check) check=1 ;;
		--from) from=${2:?lsw upgrade --from <lsw-*.tar.gz>} && shift ;;
		*) die "lsw upgrade [--check] [--from lsw-*.tar.gz]" ;;
		esac
		shift
	done

	# git-клон: обновляет git, VM и vm.conf не трогаются
	if [[ -z $from ]] && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		info "lsw из git-клона: $dir"
		git -C "$dir" fetch -q || die "git fetch не удался"
		latest=$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null) || die "у ветки нет upstream (git -C $dir branch -u origin/main)"
		((latest)) || { info "уже последняя: lsw $LSW_VERSION"; return; }
		[[ -z $check ]] || { info "новых коммитов: $latest — обновить: lsw upgrade"; return; }
		git -C "$dir" pull -q --ff-only || die "git pull --ff-only не прошёл: локальные изменения или ветка разошлась ($dir)"
		"$self" version
		"$self" deps quiet || true
		return
	fi

	# установка из релиза: последний tar.gz с GitHub или указанный архив (офлайн-набор тоже подходит)
	if [[ -z $from ]]; then
		# gh — и для приватного репозитория; curl — без gh, если репозиторий публичный
		latest=$(gh release view -R "$LSW_REPO" --json tagName -q .tagName 2>/dev/null) ||
			latest=$(curl -fsSI -o /dev/null -w '%{redirect_url}' "https://github.com/$LSW_REPO/releases/latest" 2>/dev/null) ||
			latest=''
		latest=${latest##*/}
		latest=${latest#v}
		[[ $latest =~ ^[0-9][0-9.]*$ ]] ||
			die "не удалось узнать последнюю версию: нет интернета или доступа к $LSW_REPO (gh auth login). Без сети: lsw upgrade --from lsw-offline-….tar.gz"
		newer "$latest" "$LSW_VERSION" || { info "уже последняя: lsw $LSW_VERSION"; return; }
		[[ -z $check ]] || { info "доступна lsw $latest (установлена $LSW_VERSION) — обновить: lsw upgrade"; return; }
	fi
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	if [[ -z $from ]]; then
		info "скачиваю lsw $latest"
		gh release download "v$latest" -R "$LSW_REPO" -p lsw-ubuntu.tar.gz -O "$tmp/lsw.tar.gz" 2>/dev/null ||
			curl -fL --progress-bar -o "$tmp/lsw.tar.gz" \
				"https://github.com/$LSW_REPO/releases/download/v$latest/lsw-ubuntu.tar.gz" || die "не удалось скачать релиз"
		from=$tmp/lsw.tar.gz
	fi
	[[ -f $from ]] || die "нет файла: $from"
	tar -xzf "$from" -C "$tmp" lsw/lsw lsw/README.md 2>/dev/null || die "в $from нет lsw/lsw — это не архив lsw"
	nv=$(sed -n 's/^LSW_VERSION=//p' "$tmp/lsw/lsw")
	bash -n "$tmp/lsw/lsw" && [[ -n $nv ]] || die "lsw в архиве повреждён"
	newer "$nv" "$LSW_VERSION" || { info "в архиве lsw $nv, установлена $LSW_VERSION — обновлять нечего"; return; }
	[[ -z $check ]] || { info "в архиве lsw $nv (установлена $LSW_VERSION)"; return; }

	[[ -w $dir ]] || sudo=sudo
	# через новый файл + mv: запущенный сейчас lsw дочитывает свою старую копию
	$sudo install -m755 "$tmp/lsw/lsw" "$self.new" && $sudo mv -f "$self.new" "$self" || die "не удалось записать $self"
	[[ ! -f $dir/../share/doc/lsw/README.md ]] || $sudo install -m644 "$tmp/lsw/README.md" "$dir/../share/doc/lsw/README.md"
	info "lsw $LSW_VERSION → $nv"
	"$self" deps quiet || warn "новой версии нужны пакеты выше — или запусти install.sh из нового архива"
}

# ---------- TUI: lsw tui ----------
# Всё тяжёлое делает отдельный процесс "$SELF <команда>": die в нём не закрывает интерфейс.

ESC=$'\e'

t_pad() { # текст ширина -> ровно ширина символов (не байт: printf %-Ns считает байты)
	local s=$1 w=$2
	((w > 0)) || return 0
	((${#s} > w)) && s="${s:0:w-1}…"
	printf '%s%*s' "$s" $((w - ${#s})) ''
}

t_rep() { local s; printf -v s '%*s' "$2" ''; printf '%s' "${s// /$1}"; }

t_screen() {
	if [[ $1 == on ]]; then
		printf '%s' "$ESC[?1049h$ESC[?25l$ESC[H$ESC[2J"
		stty -echo 2>/dev/null
	else
		printf '%s' "$ESC[?25h$ESC[?1049l"
		stty echo 2>/dev/null
	fi
}

t_size() { read -r T_H T_W < <(stty size </dev/tty 2>/dev/null || echo 24 80); }

# Ctrl+C: read -n сам включает ISIG, и после trap bash продолжает ждать ввода,
# поэтому читаем короткими кусками и между ними смотрим флаг из trap (cmd_tui)
t_getc() { # [таймаут, с] -> T_C; 1 — таймаут, 2 — Ctrl+C
	local n=$((${1:-0} * 4))
	T_INTR=0
	until IFS= read -rsn1 -t 0.25 T_C; do
		((T_INTR)) && return 2
		((n == 0 || --n > 0)) || return 1
	done
}

t_key() { # [таймаут, с] -> T_KEY (up down enter esc pgup pgdn home end intr или символ); 1 — таймаут
	local k s rc=0
	t_getc "${1:-0}" || rc=$?
	((rc == 1)) && return 1
	((rc == 2)) && { T_KEY=intr; return 0; }
	k=$T_C
	case $k in
	'') T_KEY=enter ;;
	"$ESC")
		s=''
		IFS= read -rsn2 -t 0.05 s
		case $s in
		'[A' | OA) T_KEY=up ;;
		'[B' | OB) T_KEY=down ;;
		'[H' | OH) T_KEY=home ;;
		'[F' | OF) T_KEY=end ;;
		'[5' | '[6' | '[1' | '[4' | '[7' | '[8') # ESC[5~ и т.п.; Home/End бывают и такими (tmux, screen)
			IFS= read -rsn1 -t 0.05 _
			case $s in '[5') T_KEY=pgup ;; '[6') T_KEY=pgdn ;; '[1' | '[7') T_KEY=home ;; *) T_KEY=end ;; esac
			;;
		'') T_KEY=esc ;;
		*) T_KEY=other ;;
		esac
		;;
	*) T_KEY=$k ;;
	esac
}

t_msg() { T_MSGC=$1 T_MSG=$2; } # 1 ошибка, 2 успех, 3 в процессе / предупреждение

t_msg_rc() { # код вывод-команды
	local s
	s=$(sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' <<<"$2" | grep -E '[^[:space:]]' | tail -1)
	s=${s#lsw: }
	if (($1)); then t_msg 1 "${s:-ошибка}"
	elif [[ $s == '!! '* ]]; then t_msg 3 "${s#!! }"
	else t_msg 2 "${s#:: }"; fi
	[[ -n $T_MSG ]] || T_MSG=готово
}

t_do() { # команда lsw... — тихо, итог в строке статуса
	local out rc=0
	t_msg 3 "$*…"
	t_draw
	out=$("$SELF" "$@" </dev/null 2>&1) || rc=$?
	t_msg_rc "$rc" "$out"
	return "$rc"
}

t_bg() { # имя что команда... — в фоне; VM в списке помечается ⋯
	local n=$1 what=$2 log
	shift 2
	[[ -z ${T_JOB[$n]:-} ]] || { t_msg 1 "$n: уже идёт ${T_JOBWHAT[$n]}"; return 1; }
	log=$(mktemp)
	setsid "$SELF" "$@" </dev/null >"$log" 2>&1 & # переживёт выход из tui и закрытие терминала
	T_JOB[$n]=$! T_JOBLOG[$n]=$log T_JOBWHAT[$n]=$what
	t_msg 3 "$n: $what…"
}

t_reap() { # закончившиеся фоновые задачи -> строка статуса
	local n rc
	for n in "${!T_JOB[@]}"; do
		kill -0 "${T_JOB[$n]}" 2>/dev/null && continue
		rc=0
		wait "${T_JOB[$n]}" || rc=$?
		t_msg_rc "$rc" "$(<"${T_JOBLOG[$n]}")"
		if ((rc)); then T_MSG="$n: ${T_JOBWHAT[$n]} не удалась — $T_MSG"
		elif ((T_MSGC == 2)); then T_MSG="$n: ${T_JOBWHAT[$n]} — готово"; fi
		rm -f "${T_JOBLOG[$n]}"
		unset "T_JOB[$n]" "T_JOBLOG[$n]" "T_JOBWHAT[$n]" "T_INST[$n]"
	done
}

t_ext() { # [--pause] команда... — на обычном экране терминала (shell, консоль, установка)
	local pause=0 rc=0 t0=$SECONDS
	[[ $1 == --pause ]] && { pause=1; shift; }
	t_screen off
	trap ':' INT # Ctrl+C прерывает команду, а не интерфейс
	"$@" || rc=$?
	trap 'T_INTR=1' INT
	# быстрый провал (VM не стартовала и т.п.) — дать прочитать ошибку
	if ((pause || (rc != 0 && rc != 130 && SECONDS - t0 < 3))); then
		printf '\n%s' "$ESC[2m— нажми любую клавишу —$ESC[0m"
		IFS= read -rsn1 _
	fi
	t_screen on
	return "$rc"
}

t_complete() { # строка -> дополнить последнее слово как путь (Tab)
	local s=$1 w pat c i m=()
	w=${s##* }
	pat=$w
	[[ $pat == '~'* ]] && pat=$HOME${pat:1}
	mapfile -t m < <(compgen -f -- "$pat" 2>/dev/null)
	((${#m[@]})) || { printf '%s' "$s"; return; }
	c=${m[0]}
	if ((${#m[@]} == 1)); then
		[[ -d $c ]] && c+=/
	else # общий префикс
		for i in "${m[@]}"; do
			while [[ ${i:0:${#c}} != "$c" ]]; do c=${c%?}; done
		done
	fi
	[[ $w == '~'* ]] && c="~${c#"$HOME"}"
	printf '%s' "${s%"$w"}$c"
}

t_prompt() { # вопрос [что подставить] -> REPLY; 1 — отмена (Esc, Ctrl+C)
	local q=$1 s=${2:-} k rest w vis rc=0
	((${#q} > T_W / 2)) && q="${q:0:T_W/2-1}…"
	printf '%s' "$ESC[?25h"
	while :; do
		w=$((T_W - ${#q} - 1))
		((w < 10)) && w=10
		vis=$s
		((${#vis} > w)) && vis="…${vis: -$((w - 1))}"
		printf '%s' "$ESC[$T_H;1H$ESC[K$ESC[1;33m$q$ESC[0m$vis"
		t_getc || { rc=1; break; }
		k=$T_C
		case $k in
		'') break ;;
		"$ESC")
			rest=''
			IFS= read -rsn5 -t 0.05 rest
			[[ -n $rest ]] || { rc=1; break; } # одиночный Esc; стрелки игнорируем
			;;
		$'\x7f' | $'\b') s=${s%?} ;;
		$'\x15') s='' ;; # Ctrl+U
		$'\x17') # Ctrl+W
			s=${s%[ /]}
			while [[ -n $s && ${s: -1} != [\ /] ]]; do s=${s%?}; done ;;
		$'\t') s=$(t_complete "$s") ;;
		[[:cntrl:]]) ;;
		*) s+=$k ;;
		esac
	done
	printf '%s' "$ESC[?25l"
	REPLY=$s
	[[ $REPLY == '~'* ]] && REPLY=$HOME${REPLY:1}
	return "$rc"
}

t_confirm() {
	local k
	printf '%s' "$ESC[$T_H;1H$ESC[K$ESC[1;33m$1$ESC[0m [y/N] "
	t_getc || return 1
	[[ $T_C == [yYдД] ]]
}

# T_PSEL — с какого пункта начать, T_PKEYS — доп. клавиши (тоже выбирают пункт, клавиша в T_PKEY),
# T_PHINT — подсказка в нижней рамке. Удобно задавать через local в вызывающей функции.
t_pick() { # заголовок пункт... -> PICK (номер пункта), T_PKEY (enter или клавиша); 1 — Esc
	local title=$1 sel=${T_PSEL:-0} off=0 i r w h top left vis o hint=${T_PHINT:-}
	shift
	local items=("$@")
	((sel >= ${#items[@]})) && sel=$((${#items[@]} - 1))
	((sel < 0)) && sel=0
	T_PKEY=enter
	w=${#title}
	for i in "${items[@]}"; do ((${#i} > w)) && w=${#i}; done
	((${#hint} + 2 > w)) && w=$((${#hint} + 2))
	w=$((w + 4))
	((w < 30)) && w=30
	((w > T_W - 2)) && w=$((T_W - 2))
	vis=${#items[@]}
	((vis > T_H - 6)) && vis=$((T_H - 6))
	h=$((vis + 4))
	top=$(((T_H - h) / 2 + 1)) left=$(((T_W - w) / 2 + 1))
	while :; do
		((sel < off)) && off=$sel
		((sel >= off + vis)) && off=$((sel - vis + 1))
		o="$ESC[$top;${left}H┌$(t_rep ─ $((w - 2)))┐"
		o+="$ESC[$((top + 1));${left}H│ $ESC[1m$(t_pad "$title" $((w - 4)))$ESC[0m │"
		o+="$ESC[$((top + 2));${left}H├$(t_rep ─ $((w - 2)))┤"
		for ((r = 0; r < vis; r++)); do
			i=$((off + r))
			o+="$ESC[$((top + 3 + r));${left}H│"
			if ((i == sel)); then o+="$ESC[7m $(t_pad "${items[i]}" $((w - 4))) $ESC[0m"
			else o+=" $(t_pad "${items[i]}" $((w - 4))) "; fi
			o+="│"
		done
		if [[ -n $hint ]] && ((${#hint} + 6 <= w)); then
			o+="$ESC[$((top + 3 + vis));${left}H└─ $ESC[2m$hint$ESC[0m $(t_rep ─ $((w - ${#hint} - 5)))┘"
		else
			o+="$ESC[$((top + 3 + vis));${left}H└$(t_rep ─ $((w - 2)))┘"
		fi
		printf '%s' "$o"
		t_key || continue
		if [[ -n ${T_PKEYS:-} && ${#T_KEY} == 1 && $T_PKEYS == *"$T_KEY"* ]]; then
			PICK=$sel T_PKEY=$T_KEY
			return 0
		fi
		case $T_KEY in
		up | k) ((sel > 0)) && ((sel--)) ;;
		down | j) ((sel < ${#items[@]} - 1)) && ((sel++)) ;;
		home | g) sel=0 ;;
		end | G) sel=$((${#items[@]} - 1)) ;;
		enter | ' ') PICK=$sel; return 0 ;;
		esc | intr | q | h) return 1 ;;
		esac
	done
}

t_conf() { (load_vm "$1" 2>/dev/null && echo "${!2:-}"); } # имя переменная -> значение из vm.conf

t_load() { # список VM и их состояния; выделение держится за имя
	local d n i
	T_NAMES=() T_INFO=()
	T_DEF=$(default_vm)
	for d in "$VMS"/*/; do
		[[ -f $d/vm.conf ]] || continue
		n=$(basename "$d")
		T_NAMES+=("$n")
		T_INFO+=("$(
			load_vm "$n" 2>/dev/null
			s=stopped
			if is_running; then [[ $INSTALLED == 1 ]] && s=running || s=installing; fi
			echo "$s $DISTRO$([[ $ARCH == arm64 ]] && echo /arm64)"
		)")
	done
	for n in "${!T_INST[@]}"; do # ставятся из tui, vm.conf ещё нет
		[[ -f $(vm_dir "$n")/vm.conf ]] && continue
		T_NAMES+=("$n") T_INFO+=("creating ${T_INST[$n]}")
	done
	for i in "${!T_NAMES[@]}"; do [[ ${T_NAMES[i]} == "$T_CUR" ]] && T_SEL=$i; done
	((T_SEL >= ${#T_NAMES[@]})) && T_SEL=$((${#T_NAMES[@]} - 1))
	((T_SEL < 0)) && T_SEL=0
	T_CUR=${T_NAMES[T_SEL]:-}
}

t_dur() { # секунды -> 2д 3ч / 1:02:03
	local s=$1
	if ((s >= 86400)); then echo "$((s / 86400))д $((s % 86400 / 3600))ч"
	else printf '%d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60)); fi
}

t_logtail() { # файл N -> последние N непустых строк (прогресс через \r — последнее состояние)
	[[ -f $1 ]] || return 0
	# полоска curl (### 42.0%) — одной строкой и только последнее значение
	tail -c 16384 "$1" | tr '\r' '\n' | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g; s/^:: //' | grep -E '[[:alnum:]]' |
		awk '/^[#=O. -]*[0-9.]+%[[:space:]]*$/ { sub(/^[#=O. -]*/, ""); p = "загрузка " $0; next }
			/^  [0-9]+:[0-9][0-9]  / { p = $0; next }
			p != "" { print p; p = "" } { print } END { if (p != "") print p }' | tail -n "$2"
}

t_detail() { # имя -> строки "вид|текст" для правой панели
	(
		local ilog l
		ilog=$(t_ilog "$1")
		if [[ ! -f $(vm_dir "$1")/vm.conf ]]; then # ещё создаётся: только ход установки
			echo "S|2|создаётся"
			echo "B|"
			echo "H|Установка"
			t_logtail "$ilog" 12 | while IFS= read -r l; do echo "L|$l"; done
			exit 0
		fi
		load_vm "$1" 2>/dev/null || exit 0
		FWDS=${FWDS:-}
		local pid up rss sz share f p a h g snaps
		if pid=$(qemu_pid); then
			up=$(ps -o etimes= -p "$pid" | tr -d ' ')
			rss=$(ps -o rss= -p "$pid" | tr -d ' ')
			if [[ $INSTALLED == 1 ]]; then echo "S|1|запущена · $(t_dur "$up") · $((rss / 1024)) MiB на хосте"
			else echo "S|2|устанавливается · $(t_dur "$up")"; fi
		else
			echo "S|0|остановлена"
		fi
		sz=$(disk_bytes) && sz=$(human "$sz") || sz='?'
		echo "K|Система|$DISTRO · $TYPE · $ARCH"
		echo "K|Ресурсы|$CPUS CPU · $MEM RAM · диск $sz (файл $(du -h "$DIR/disk.qcow2" | cut -f1))"
		echo "K|SSH|127.0.0.1:$PORT · $VMUSER"
		if [[ -n $SHARE ]]; then
			share=$SHARE
			[[ $share == "$HOME" || $share == "$HOME"/* ]] && share="~${share#"$HOME"}"
			echo "K|Папка|$share → /mnt/host$([[ ${SHARE_RO:-0} == 1 ]] && echo ' (только чтение)')"
		else
			echo "K|Папка|нет, VM изолирована"
		fi
		echo "B|"
		echo "H|Порты"
		echo "T|127.0.0.1:$PORT → 22 ssh"
		for f in $FWDS; do
			IFS=: read -r p a h g <<<"$f"
			echo "T|$a:$h → $g $p"
		done
		echo "B|"
		echo "H|Снимки"
		snaps=$(qemu-img snapshot -l -U "$DIR/disk.qcow2" 2>/dev/null | awk 'NR > 2 {printf "T|%-22s %s %s\n", $2, $5, substr($6, 1, 5)}')
		if [[ -n $snaps ]]; then echo "$snaps"; else echo "D|нет"; fi
		if [[ $INSTALLED != 1 && -f $ilog ]]; then
			echo "B|"
			echo "H|Установка"
			t_logtail "$ilog" 8 | while IFS= read -r l; do echo "L|$l"; done
		fi
	)
}

t_hints() { # ширина -> строка подсказок, сколько влезет
	local w=$1 out='' len=0 i k l
	local hk=('?' помощь q выход '↵' shell s старт/стоп r рестарт e ресурсы p порты n снимки f папка c консоль l логи '*' основная i новая d удалить)
	for ((i = 0; i < ${#hk[@]}; i += 2)); do
		k=${hk[i]} l=${hk[i + 1]}
		((len + ${#k} + ${#l} + 3 > w)) && break
		out+=" $ESC[1;36m$k$ESC[0m $ESC[2m$l$ESC[0m "
		len=$((len + ${#k} + ${#l} + 3))
	done
	printf '%s' "$out"
}

t_draw() {
	t_size
	local W=$T_W H=$T_H body lw rw i r n st ds dot mark sel run=0 o line k a b
	local L=() R=() D=()
	body=$((H - 3))
	if ((W >= 72)); then lw=32 rw=$((W - lw - 3)); else lw=$W rw=$((W - 2)); fi

	for i in "${!T_NAMES[@]}"; do
		n=${T_NAMES[i]} st=${T_INFO[i]%% *} ds=${T_INFO[i]#* }
		case $st in
		running) dot="$ESC[32m●" run=$((run + 1)) ;;
		installing) dot="$ESC[33m◐" ;;
		*) dot="$ESC[90m○" ;;
		esac
		[[ -n ${T_JOB[$n]:-} ]] && dot="$ESC[36m⋯"
		[[ $n == "$T_DEF" ]] && mark='* ' || mark='  '
		((i == T_SEL)) && sel="$ESC[7m" || sel=''
		L+=("$sel $dot$ESC[39m $(t_pad "$mark$n" $((lw - 18))) $(t_pad "$ds" 13) $ESC[0m")
	done
	((${#T_NAMES[@]})) || L=("" "$(t_pad '  VM пока нет' "$lw")" "" "$(t_pad '  i — установить' "$lw")")

	if [[ -n $T_CUR ]]; then
		R+=("$ESC[1m$(t_pad "$T_CUR$([[ $T_CUR == "$T_DEF" ]] && echo '  (по умолчанию)')" "$rw")$ESC[0m")
		[[ -n ${T_JOB[$T_CUR]:-} ]] && R+=("$ESC[36m$(t_pad "⋯ ${T_JOBWHAT[$T_CUR]}…" "$rw")$ESC[0m")
		while IFS='|' read -r k a b; do
			case $k in
			S)
				case $a in 1) dot="$ESC[32m●" ;; 2) dot="$ESC[33m◐" ;; *) dot="$ESC[90m○" ;; esac
				R+=("$dot $(t_pad "$b" $((rw - 2)))$ESC[0m") ;;
			K) R+=("$ESC[2m$(t_pad "$a" 9)$ESC[0m$(t_pad "$b" $((rw - 9)))") ;;
			H) R+=("$ESC[1;36m$(t_pad "$a" "$rw")$ESC[0m") ;;
			T) R+=("  $(t_pad "$a" $((rw - 2)))") ;;
			D) R+=("  $ESC[2m$(t_pad "$a" $((rw - 2)))$ESC[0m") ;;
			L) R+=("  $ESC[2m$(t_pad "$a${b:+|$b}" $((rw - 2)))$ESC[0m") ;;
			B) R+=("") ;;
			esac
		done < <(t_detail "$T_CUR")
	fi

	o="$ESC[H$ESC[1;7m$(t_pad " lsw $LSW_VERSION · ${#T_NAMES[@]} VM, запущено $run" "$W")$ESC[0m$ESC[K"
	if ((W >= 72)); then
		for ((r = 0; r < body; r++)); do
			line=${L[r]:-$(t_pad '' "$lw")}
			o+=$'\n'"$line $ESC[90m│$ESC[0m ${R[r]:-}$ESC[K"
		done
	else # узкий терминал: список, под ним подробности
		D=("${L[@]}" "$ESC[90m$(t_rep ─ "$W")$ESC[0m")
		for line in "${R[@]}"; do D+=(" $line"); done
		for ((r = 0; r < body; r++)); do o+=$'\n'"${D[r]:-}$ESC[K"; done
	fi
	o+=$'\n'"$(t_hints "$W")$ESC[K"
	case $T_MSGC in 1) line="$ESC[31m" ;; 2) line="$ESC[32m" ;; *) line="$ESC[33m" ;; esac
	o+=$'\n'"$line$(t_pad " $T_MSG" $((W - 1)))$ESC[0m$ESC[K"
	printf '%s' "$o"
}

t_restart_offer() { # имя — после изменений, которым нужен перезапуск
	[[ ${T_INFO[T_SEL]%% *} == running ]] || return 0
	if t_confirm "Перезапустить $1 сейчас, чтобы применить?"; then t_bg "$1" перезапуск restart "$1"
	else t_msg 3 "$1: применится после перезапуска (r)"; fi
}

t_resources() {
	local n=$1 c m sz args=()
	c=$(t_conf "$n" CPUS) m=$(t_conf "$n" MEM)
	sz=$(DIR=$(vm_dir "$n") disk_bytes) && sz=$(human "$sz")
	t_pick "Ресурсы $n" "CPU: $c" "Память: $m" "Диск: $sz (только увеличить)" || return
	case $PICK in
	0) t_prompt "CPU: " "$c" || return; args=(--cpus "$REPLY") ;;
	1) t_prompt "Память (4G, 4096M): " "$m" || return; args=(--mem "$REPLY") ;;
	2) t_prompt "Диск (60G или +10G): " "+10G" || return; args=(--disk "$REPLY") ;;
	esac
	[[ -n $REPLY ]] || return
	t_do set "$n" "${args[@]}" || return
	((PICK == 2)) || t_restart_offer "$n"
}

t_ports() {
	local n=$1 f p a h g fw items=() specs=()
	fw=$(t_conf "$n" FWDS)
	for f in $fw; do
		IFS=: read -r p a h g <<<"$f"
		items+=("$a:$h → $g  $p")
		specs+=("$h/$p")
	done
	items+=("+ открыть порт")
	t_pick "Порты $n (ssh: $(t_conf "$n" PORT))" "${items[@]}" || return
	if ((PICK == ${#specs[@]})); then
		t_prompt "Порт: 8080 · 3000:80 · 0.0.0.0:8080:80 · 5353/udp > " || return
		[[ -z $REPLY ]] || t_do port "$n" "$REPLY"
	else
		t_confirm "Закрыть ${items[PICK]}?" && t_do port "$n" rm "${specs[PICK]}"
	fi
}

t_snaps() {
	local n=$1 tag d t tags=() items=("+ сделать снимок")
	while read -r tag d t; do
		tags+=("$tag")
		items+=("$tag  $d $t")
	done < <(qemu-img snapshot -l -U "$(vm_dir "$n")/disk.qcow2" 2>/dev/null | awk 'NR > 2 {print $2, $5, substr($6, 1, 5)}')
	t_pick "Снимки $n" "${items[@]}" || return
	if ((PICK == 0)); then
		t_prompt "Метка снимка: " "$(date +%Y%m%d-%H%M%S)" || return
		[[ -z $REPLY ]] || t_do snapshot "$n" save "$REPLY"
		return
	fi
	tag=${tags[PICK - 1]}
	t_pick "Снимок $tag" "Вернуть $n к этому снимку" "Удалить снимок" || return
	if ((PICK == 0)); then
		t_confirm "Вернуть $n к '$tag'? Всё, что изменилось после снимка, пропадёт." &&
			t_bg "$n" "откат к $tag" snapshot "$n" restore "$tag" -f
	else
		t_confirm "Удалить снимок '$tag'?" && t_do snapshot "$n" rm "$tag"
	fi
}

t_share() {
	local n=$1 cur spec
	cur=$(t_conf "$n" SHARE)
	[[ -n $cur && $(t_conf "$n" SHARE_RO) == 1 ]] && cur+=:ro
	t_prompt "Папка хоста (пусто — изолировать, …:ro — только чтение): " "$cur" || return
	spec=${REPLY:-off}
	[[ $spec != "${cur:-off}" ]] || return
	t_do share "$n" "$spec" || return
	t_restart_offer "$n"
}

t_img_new() { # вид дистрибутив арх путь — спросить имя и опции, поставить VM
	local k=$1 d=$2 a=$3 p=$4 name base i=2 args=() extra=() e hint='--cpus 4 --mem 4G --disk 40G --share ~/Work'
	case $k in
	cloud) name=$d; [[ $a == arm64 ]] && name=$d-arm ;;
	ubuntu)
		name=$(grep -oE '[0-9]{2}\.[0-9]{2}' <<<"${p##*/}" | head -1)
		name=ubuntu-${name:-iso}; name=${name//./} ;;
	windows) name=win; [[ $(iso_label windows "$p") == *11 ]] && name=win11
		hint='--cpus 4 --mem 8G --disk 80G --share ~/Work' ;;
	esac
	base=$name
	while [[ -e $(vm_dir "$name") ]]; do name=$base-$i; ((i++)); done
	t_prompt "Имя VM: " "$name" || return
	[[ -n $REPLY ]] || return
	name=$REPLY
	args=(install "$d" "$name")
	[[ $k == cloud ]] || args+=(--iso "$p")
	[[ $a == arm64 ]] && args+=(--arch arm64)
	t_prompt "Опции, можно пусто ($hint): " || return
	read -ra extra <<<"$REPLY"
	for e in "${!extra[@]}"; do [[ ${extra[e]} == '~'* ]] && extra[e]=$HOME${extra[e]:1}; done
	t_install_job "$name" "$([[ $k == cloud ]] && echo "$d" || echo "$d iso")$([[ $a == arm64 ]] && echo /arm64)" "${args[@]}" "${extra[@]}"
}

t_ilog() { echo "$LSW_HOME/logs/install-$1.log"; } # лог установки: живёт, пока VM не установлена

t_install_job() { # имя подпись команда... — установка в фоне, ход виден справа
	local n=$1 label=$2 log
	shift 2
	[[ -z ${T_JOB[$n]:-} ]] || { t_msg 1 "$n: уже идёт ${T_JOBWHAT[$n]}"; return 1; }
	log=$(t_ilog "$n")
	mkdir -p "${log%/*}"
	# setsid: установка переживёт выход из tui и закрытие терминала
	setsid "$SELF" "$@" </dev/null >"$log" 2>&1 &
	T_JOB[$n]=$! T_JOBLOG[$n]=$log T_JOBWHAT[$n]=установка T_INST[$n]=$label
	T_CUR=$n
	t_msg 3 "$n: установка… (ход — справа, d — прервать)"
}

t_abort_install() { # имя — прервать установку из tui и удалить VM
	local n=$1 pid=${T_JOB[$1]}
	t_confirm "Прервать установку $n и удалить VM?" || return
	kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	rm -f "${T_JOBLOG[$n]}"
	unset "T_JOB[$n]" "T_JOBLOG[$n]" "T_JOBWHAT[$n]" "T_INST[$n]"
	if [[ -f $(vm_dir "$n")/vm.conf ]]; then t_bg "$n" удаление rm "$n" -f
	else rm -rf "$(vm_dir "$n")"; t_msg 2 "$n: установка прервана"; fi
}

t_install() { # новая VM из образа: облачные (скачанные и нет) и найденные ISO
	local T_PKEYS=ud T_PHINT='↵ создать VM · u скачать/обновить · d удалить' T_PSEL=0
	local K=() Dd=() A=() P=() L=() items=() k d a p l m job dl lw i
	while :; do
		K=() Dd=() A=() P=() L=() items=() lw=0
		while IFS='|' read -r k d a p l; do
			K+=("$k") Dd+=("$d") A+=("$a") P+=("$p") L+=("$l")
			((${#l} > lw)) && lw=${#l}
		done < <(image_scan)
		for i in "${!K[@]}"; do
			k=${K[i]} p=${P[i]} l=${L[i]}
			job=${T_JOB["образ $l"]:-}
			if [[ $k == cloud ]]; then
				if [[ -n $job ]]; then m="⋯ $(t_pad "$l" "$lw") качается… $( [[ -f $p.part ]] && human "$(stat -c %s "$p.part")")"
				elif [[ -f $p ]]; then m="✓ $(t_pad "$l" "$lw") $(image_meta "$p")"
				else m="↓ $(t_pad "$l" "$lw") скачается при создании"; fi
			else
				case $k in desktop | arm) m='✗' ;; *) m='◉' ;; esac
				m="$m $(t_pad "$l" "$lw") $(human "$(stat -c %s "$p")") · ${p##*/}"
			fi
			items+=("$m")
		done
		items+=("+ ISO из другого места…")
		t_draw
		t_pick "Новая VM — выбери образ" "${items[@]}" || return
		T_PSEL=$PICK
		if ((PICK == ${#K[@]})); then # свой путь к ISO
			[[ $T_PKEY == enter ]] || continue
			dl=$(iso_dirs | sed -n 2p)
			t_prompt "Путь к ISO (Ubuntu Server или Windows 10): " "$dl/" || continue
			p=$REPLY
			[[ -f $p ]] || { t_msg 1 "нет файла $p"; continue; }
			p=$(realpath "$p") k=$(iso_kind "$p")
			[[ $k == unknown ]] && k=$(iso_probe "$p")
			case $k in
			desktop | arm) t_msg 1 "${p##*/}: $(iso_label "$k" "$p")"; continue ;;
			esac
			t_img_new "$k" "$([[ $k == windows ]] && echo windows || echo ubuntu)" amd64 "$p"
			return
		fi
		k=${K[PICK]} d=${Dd[PICK]} a=${A[PICK]} p=${P[PICK]} l=${L[PICK]}
		job=${T_JOB["образ $l"]:-}
		case $T_PKEY in
		enter)
			[[ -z $job ]] || { t_msg 3 "$l ещё качается — подожди"; continue; }
			if [[ $k == unknown ]]; then
				t_msg 3 "смотрю, что в ${p##*/}…"; t_draw
				k=$(iso_probe "$p") d=ubuntu
				[[ $k == windows ]] && d=windows
				t_msg 2 "${p##*/}: $(iso_label "$k" "$p")"
			fi
			case $k in
			desktop | arm) t_msg 1 "${p##*/}: $(iso_label "$k" "$p")"; continue ;;
			esac
			t_img_new "$k" "$d" "$a" "$p"
			return
			;;
		u)
			[[ $k == cloud ]] || { t_msg 1 "ISO не скачиваются через lsw — только облачные образы"; continue; }
			t_bg "образ $l" "$([[ -f $p ]] && echo обновление || echo загрузка)" pull "$d" --arch "$a"
			return
			;;
		d)
			[[ -n $job ]] && { t_msg 1 "$l качается — подожди окончания"; continue; }
			[[ -f $p ]] || { t_msg 1 "$l не скачан"; continue; }
			if [[ $(realpath "$(dirname "$p")") != "$(realpath -m "$CACHE")" ]]; then
				t_msg 1 "${p/#"$HOME"/\~} не в кеше lsw — удаляй сам"; continue
			fi
			t_confirm "Удалить ${p##*/} ($(human "$(stat -c %s "$p")")) из кеша?" && t_do images rm "$p"
			continue
			;;
		esac
	done
}

t_help() {
	t_pick "Клавиши (Esc — закрыть)" \
		"↑↓ j k     выбрать VM" \
		"Enter      терминал гостя (exit — назад)" \
		"s          запустить / остановить" \
		"r          перезапустить" \
		"e          CPU, память, диск" \
		"p          проброс портов" \
		"n          снимки: сделать, вернуть, удалить" \
		"f          общая папка с хостом" \
		"c          серийная консоль (выход Ctrl+])" \
		"l          лог консоли (выход Ctrl+C)" \
		"*          сделать VM основной (lsw без имени)" \
		"i          новая VM из образа (там: u — скачать, d — удалить)" \
		"d          удалить VM (во время установки — прервать её)" \
		"q          выйти (VM продолжат работать)" || true
}

cmd_tui() {
	[[ -t 0 && -t 1 ]] || die "lsw tui работает только в терминале"
	set +eu # интерфейс не должен падать из-за ((...)) == 0 или пустых переменных
	[[ $(locale charmap 2>/dev/null) == UTF-8 ]] || export LC_ALL=C.UTF-8
	SELF=$(readlink -f "$0")
	declare -gA T_JOB=() T_JOBLOG=() T_JOBWHAT=() T_INST=()
	T_SEL=0 T_CUR=$(default_vm) T_DEF='' T_MSG='' T_MSGC=2 T_KEY='' PICK=0
	ensure_key
	trap 't_screen off' EXIT
	trap ':' WINCH
	trap 'T_INTR=1' INT
	t_screen on
	local reload=1 n st
	while :; do
		t_reap
		((reload)) && t_load
		reload=1
		t_draw
		t_key 2 || continue # раз в 2 с — обновить состояния
		n=$T_CUR st=${T_INFO[T_SEL]%% *}
		case $T_KEY in
		up | k) ((T_SEL > 0)) && ((T_SEL--)); reload=0 ;;
		down | j) ((T_SEL < ${#T_NAMES[@]} - 1)) && ((T_SEL++)); reload=0 ;;
		home | g | pgup) T_SEL=0 reload=0 ;;
		end | G | pgdn) T_SEL=$((${#T_NAMES[@]} - 1)) reload=0 ;;
		q | Q | intr)
			if ((${#T_JOB[@]})); then
				local j jobs=''
				for j in "${!T_JOB[@]}"; do jobs+="${jobs:+, }$j — ${T_JOBWHAT[$j]}"; done
				t_confirm "Идёт: $jobs. Выйти? Продолжится в фоне" || continue
			fi
			exit 0 ;;
		'?' | h) t_help ;;
		i) t_install ;;
		*)
			if [[ -z $n ]]; then
				[[ $T_KEY == enter ]] && t_install
				continue
			fi
			if [[ -n ${T_INST[$n]:-} ]]; then # ставится из tui
				case $T_KEY in
				d | x) t_abort_install "$n" ;;
				enter | l) [[ $st == creating ]] && t_msg 3 "$n ещё создаётся — ход установки справа" || t_ext "$SELF" logs "$n" ;;
				s | r | e | p | n | f | c | '*') t_msg 3 "$n ещё ставится — подожди (d — прервать)" ;;
				esac
				((reload)) || T_CUR=${T_NAMES[T_SEL]:-}
				continue
			fi
			case $T_KEY in
			enter)
				if [[ $st == installing ]]; then t_ext "$SELF" logs "$n"
				else t_ext "$SELF" shell "$n"; fi ;;
			s)
				if [[ $st == stopped ]]; then t_bg "$n" запуск start "$n"
				else t_bg "$n" остановка stop "$n"; fi ;;
			r) t_bg "$n" перезапуск restart "$n" ;;
			e) t_resources "$n" ;;
			p) t_ports "$n" ;;
			n) t_snaps "$n" ;;
			f) t_share "$n" ;;
			c)
				if [[ $st == stopped ]]; then t_msg 1 "$n не запущена (s — запустить)"
				else t_ext "$SELF" console "$n"; fi ;;
			l) t_ext "$SELF" logs "$n" ;;
			'*') t_do default "$n" ;;
			d | x) t_confirm "Удалить VM $n вместе с диском и снимками?" && t_bg "$n" удаление rm "$n" -f ;;
			esac
			;;
		esac
		((reload)) || T_CUR=${T_NAMES[T_SEL]:-}
	done
}

main() {
	mkdir -p "$VMS"
	local c=${1:-}
	(($#)) && shift
	case $c in
	'') # без VM по умолчанию в терминале — интерфейс
		if [[ -n $(default_vm) ]]; then cmd_shell
		elif [[ -t 0 && -t 1 ]]; then cmd_tui
		else usage; fi ;;
	tui | ui) cmd_tui ;;
	install | i) cmd_install "$@" ;;
	list | ls) cmd_list ;;
	shell | sh) cmd_shell "$@" ;;
	run) cmd_run "$@" ;;
	start) load_vm "${1:?имя}" && vm_start && { [[ $INSTALLED != 1 ]] || wait_ssh 180 || warn "ssh пока не отвечает"; } ;;
	stop)
		if [[ ${1:-} == --all ]]; then
			local d
			for d in "$VMS"/*/; do [[ -f $d/vm.conf ]] && (load_vm "$(basename "$d")" && vm_stop); done
		else
			load_vm "${1:?имя}" && vm_stop
		fi
		;;
	restart) load_vm "${1:?имя}" && vm_stop && vm_start && { [[ $INSTALLED != 1 ]] || { wait_ssh 180 && ensure_mount; } || warn "ssh пока не отвечает"; } ;;
	console) cmd_console "$@" ;;
	logs) load_vm "$(resolve_name "${1:-}")" && tail -n "${2:-100}" -f "$DIR/console.log" ;;
	default) load_vm "${1:?имя}" && echo "$1" >"$LSW_HOME/default" && info "по умолчанию: $1" ;;
	ssh-config) cmd_ssh_config "$@" ;;
	share) cmd_share "$@" ;;
	set) cmd_set "$@" ;;
	port | ports) cmd_port "$@" ;;
	snapshot | snap | snapshots) cmd_snapshot "$@" ;;
	rm | remove) cmd_rm "$@" ;;
	pull) cmd_pull "$@" ;;
	images | image | img) cmd_images "$@" ;;
	deps) cmd_deps ;;
	version | --version | -V) echo "lsw $LSW_VERSION ($(readlink -f "$0"))" ;;
	upgrade | update) cmd_upgrade "$@" ;;
	-h | --help | help) usage ;;
	*)
		# lsw <имя VM> — терминал этой VM
		[[ -f $(vm_dir "$c")/vm.conf ]] && cmd_shell "$c"
		die "неизвестная команда: $c (lsw help)"
		;;
	esac
}

main "$@"
