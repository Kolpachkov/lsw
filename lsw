#!/usr/bin/env bash
# lsw — WSL-подобные headless-VM для Linux на QEMU/KVM (гости: Ubuntu, Arch, Windows 10; Ubuntu arm64 — эмуляция)
set -euo pipefail

LSW_HOME=${LSW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lsw}
VMS=$LSW_HOME/vms
CACHE=$LSW_HOME/cache
KEY=$LSW_HOME/id_ed25519
LSW_VERSION=0.7.4
LSW_REPO=${LSW_REPO:-Kolpachkov/lsw} # откуда lsw upgrade берёт релизы
WIN_GENERIC_KEY=VK7JG-NPHTM-C97JM-9MPGT-3V66T # публичный generic-ключ Win10 Pro: только установка, без активации

die()  { printf '\e[1;31mlsw:\e[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\e[1;34m::\e[0m %s\n' "$*" >&2; }
warn() { printf '\e[1;33m!!\e[0m %s\n' "$*" >&2; }

usage() {
	cat <<'EOF'
lsw — лёгкие терминальные виртуалки (Linux / Windows 10) на QEMU/KVM

  lsw install <ubuntu|ubuntu-24.04|ubuntu-22.04|arch> [имя] [опции]
  lsw install ubuntu  [имя] --iso ubuntu-XX.04-live-server-amd64.iso  (автоустановка с ISO)
  lsw install windows [имя] --iso Win10.iso [опции]
      --cpus N        (linux 2, windows 4)
      --mem  4G       (linux 2G, windows 4G)
      --disk 40G      (linux 20G, windows 64G)
      --arch arm64    ARM-гость (только ubuntu*, без KVM — программная эмуляция, в разы медленнее)
      --share DIR[:ro]  открыть папку хоста в госте как /mnt/host (:ro — только чтение);
                        по умолчанию VM изолирована и ничего с хоста не видит
      --user NAME     пользователь в госте (по умолчанию — как на хосте; ivan@corp.ru -> ivan)
      --password P    пароль пользователя (по умолчанию = имя пользователя)
      --key XXXXX-... ключ продукта Windows (по умолчанию generic Pro)
      --edition N     индекс редакции в install.wim/esd
      --lang ru-RU    язык ISO Windows (обычно определяется сам)
      --vnc           включить VNC 127.0.0.1:59xx (посмотреть, что с установкой Windows)

  lsw tui                   интерфейс в терминале: все VM и действия над ними
  lsw                       shell в VM по умолчанию (если её нет — tui)
  lsw shell [имя]           терминал гостя (VM запустится сама); то же: lsw <имя>
  lsw run <имя> [-- cmd...] выполнить команду в госте (без команды — терминал)
  lsw list                  список VM
  lsw start|stop|restart <имя>
  lsw stop --all
  lsw console <имя>         серийная консоль (выход: Ctrl+])
  lsw logs <имя>            лог консоли
  lsw default <имя>         VM по умолчанию
  lsw share [имя] [DIR[:ro]|off]  показать / сменить общую папку (без имени — VM по умолчанию)
  lsw set [имя] [--cpus N] [--mem 4G] [--disk 40G|+10G]
                            показать / изменить ресурсы VM (диск — только увеличить)
  lsw port [имя] [HOST[:GUEST]] открыть порт гостя на 127.0.0.1:HOST хоста (без порта — список)
      0.0.0.0:8080:80  — доступно из сети;  8080/udp — UDP;  lsw port [имя] rm 8080
  lsw snapshot [имя] [list|save [метка]|restore <метка> [-f]|rm <метка>]
                            снимки диска; save работает и на запущенной VM
  lsw ssh-config [имя]      блок для ~/.ssh/config (scp, rsync, VS Code)
  lsw rm <имя> [-f]         удалить VM
  lsw images                скачанные облачные образы и найденные ISO (кеш, ~/Downloads, $LSW_ISO_DIRS)
  lsw images rm <образ>     удалить образ из кеша (ubuntu-24.04, ubuntu-arm64, файл.iso)
  lsw pull <дистрибутив> [--arch arm64]  скачать / обновить облачный образ
  lsw deps                  проверить зависимости
  lsw version               версия и путь к скрипту
  lsw upgrade [--check]     обновить lsw (git pull или последний релиз); VM не трогаются
  lsw upgrade --from F.tar.gz  обновить из скачанного архива (без интернета)
EOF
}

# ---------- зависимости ----------

find_virtiofsd() {
	# нужен Rust-virtiofsd (--shared-dir); старый C-вариант из qemu 6.x (Ubuntu 22.04) не подходит
	local p
	for p in "$(command -v virtiofsd 2>/dev/null)" /usr/lib/virtiofsd /usr/libexec/virtiofsd /usr/lib/qemu/virtiofsd "$LSW_HOME/bin/virtiofsd"; do
		[[ -n $p && -x $p ]] && "$p" --help 2>&1 | grep -q -- --shared-dir && { echo "$p"; return; }
	done
	return 1
}

# Где нет пакета virtiofsd (Ubuntu 22.04, Debian 11), берём статический бинарник (musl) из релиза
# virtiofsd и кладём в $LSW_HOME/bin — без sudo. Версия и sha256 закреплены.
VIRTIOFSD_VER=1.14.0
VIRTIOFSD_URL=https://gitlab.com/-/project/21523468/uploads/f505704014ae7a816e515f2a05a93d8b/virtiofsd-v$VIRTIOFSD_VER.zip
VIRTIOFSD_SHA256=2e4fe9571f492b00baa34bc4e708e950039c5da05b830b31a8d179cb6ac8978e

fetch_virtiofsd() {
	local tmp bin=$LSW_HOME/bin/virtiofsd
	[[ $(uname -m) == x86_64 ]] || return 1
	tmp=$(mktemp -d)
	info "virtiofsd не найден — скачиваю virtiofsd $VIRTIOFSD_VER в ${bin/#"$HOME"/\~}"
	if curl -fsSL -o "$tmp/v.zip" "$VIRTIOFSD_URL" &&
		[[ $(sha256sum "$tmp/v.zip" | cut -d' ' -f1) == "$VIRTIOFSD_SHA256" ]] &&
		{ unzip -q -o -j "$tmp/v.zip" '*/virtiofsd' -d "$tmp" 2>/dev/null ||
			python3 -I -c 'import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
n = [i for i in z.namelist() if i.endswith("/virtiofsd")][0]
open(sys.argv[2], "wb").write(z.read(n))' "$tmp/v.zip" "$tmp/virtiofsd"; } 2>/dev/null &&
		chmod +x "$tmp/virtiofsd" && "$tmp/virtiofsd" --help 2>&1 | grep -q -- --shared-dir; then
		mkdir -p "${bin%/*}"
		mv "$tmp/virtiofsd" "$bin"
		rm -rf "$tmp"
		return 0
	fi
	rm -rf "$tmp"
	warn "не удалось скачать virtiofsd ($VIRTIOFSD_URL)"
	return 1
}

ensure_virtiofsd() { find_virtiofsd >/dev/null || fetch_virtiofsd; }

apt_has() { command -v apt-cache >/dev/null && apt-cache show "$1" >/dev/null 2>&1; }

cmd_deps() {
	local missing=() c
	for c in qemu-system-x86_64 qemu-img xorriso socat ssh ssh-keygen curl; do
		command -v "$c" >/dev/null || missing+=("$c")
	done
	ensure_virtiofsd || missing+=(virtiofsd)
	[[ -w /dev/kvm ]] || warn "/dev/kvm недоступен для записи — без KVM будет очень медленно"
	if ((${#missing[@]})); then
		warn "не хватает: ${missing[*]}"
		if command -v apt-get >/dev/null; then
			echo "  sudo apt install qemu-system-x86 qemu-utils ipxe-qemu$(apt_has virtiofsd && echo ' virtiofsd') xorriso socat openssh-client curl" >&2
		elif command -v dnf >/dev/null; then
			echo "  sudo dnf install qemu-kvm qemu-img virtiofsd xorriso socat openssh-clients curl" >&2
		else
			echo "  sudo pacman -S --needed qemu-base virtiofsd libisoburn socat 7zip openssh curl" >&2
		fi
		[[ ${1:-} == quiet ]] && exit 1
		return 1
	fi
	[[ ${1:-} == quiet ]] && return
	find_aarch64 >/dev/null || warn "для arm64-гостей нужны qemu-system-aarch64 и UEFI: sudo pacman -S qemu-system-aarch64 edk2-aarch64 / sudo apt install qemu-system-arm qemu-efi-aarch64"
	find_7z >/dev/null || warn "для Windows желателен 7z (читает ISO Microsoft): sudo pacman -S 7zip / sudo apt install 7zip"
	info "все зависимости на месте"
}

# UEFI-прошивка для arm64 (virt): Arch/Fedora edk2-aarch64, Debian/Ubuntu qemu-efi-aarch64
find_aavmf() {
	local f
	for f in /usr/share/edk2/aarch64/QEMU_EFI.fd /usr/share/qemu-efi-aarch64/QEMU_EFI.fd \
		/usr/share/edk2-armvirt/aarch64/QEMU_EFI.fd /usr/share/AAVMF/AAVMF_CODE.fd; do
		[[ -f $f ]] && { echo "$f"; return; }
	done
	return 1
}

find_aarch64() { command -v qemu-system-aarch64 >/dev/null && find_aavmf; }

ensure_key() {
	[[ -f $KEY ]] || ssh-keygen -q -t ed25519 -N '' -C lsw -f "$KEY"
}

# ---------- VM: конфиг и состояние ----------

vm_dir() { echo "$VMS/$1"; }

load_vm() {
	NAME=$1
	DIR=$(vm_dir "$NAME")
	[[ -f $DIR/vm.conf ]] || die "VM '$NAME' не найдена (lsw list)"
	ARCH=amd64 # VM до 0.5.0 — без ARCH в vm.conf
	# shellcheck disable=SC1091
	source "$DIR/vm.conf"
}

conf_set() { # key value
	# без sed: в значении бывают пробелы, \ и | (printf %q)
	local line
	line=$(printf '%s=%q' "$1" "$2")
	{ grep -v "^$1=" "$DIR/vm.conf" || true; echo "$line"; } >"$DIR/vm.conf.new"
	mv -f "$DIR/vm.conf.new" "$DIR/vm.conf"
	printf -v "$1" '%s' "$2" # и в текущем процессе, чтобы перезапуск взял новое значение
}

default_vm() {
	if [[ -f $LSW_HOME/default ]]; then cat "$LSW_HOME/default"; fi
}

resolve_name() { # [имя] -> имя, иначе VM по умолчанию
	local n=${1:-$(default_vm)}
	[[ -n $n ]] || die "не указано имя VM и нет VM по умолчанию (lsw default <имя>)"
	echo "$n"
}

qemu_pid() {
	local pid
	[[ -f $DIR/qemu.pid ]] || return 1
	pid=$(<"$DIR/qemu.pid")
	[[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && grep -q qemu "/proc/$pid/comm" 2>/dev/null || return 1
	echo "$pid"
}

is_running() { qemu_pid >/dev/null; }

# порты хоста, занятые VM (ssh и проброшенные): "порт vm" по строке
vm_host_ports() {
	local c
	for c in "$VMS"/*/port.reserve; do # VM ещё ставится: vm.conf нет, порт уже занят
		[[ -f $c && ! -f ${c%/*}/vm.conf ]] && echo "$(<"$c") $(basename "${c%/*}")"
	done
	for c in "$VMS"/*/vm.conf; do
		[[ -f $c ]] || continue
		(
			FWDS=''
			# shellcheck disable=SC1090
			source "$c"
			n=$(basename "$(dirname "$c")")
			echo "$PORT $n"
			for f in $FWDS; do IFS=: read -r _ _ h _ <<<"$f" && echo "$h $n"; done
		)
	done
}

free_port() {
	local p=2222 used
	used=$(vm_host_ports | cut -d' ' -f1)
	while grep -qx "$p" <<<"$used" || ss -Hltn "sport = :$p" 2>/dev/null | grep -q .; do
		((p++))
	done
	echo "$p"
}

# ---------- ssh ----------

ssh_opts() {
	# -F /dev/null: чужие ~/.ssh/config и /etc/ssh/ssh_config.d (ProxyJump на все хосты, урезанные
	# алгоритмы на рабочих машинах) не должны ломать ssh в гостя; IdentitiesOnly — без ключей из агента
	# (их перебор упирается в MaxAuthTries раньше нашего ключа)
	SSH=(ssh -F /dev/null -i "$KEY" -p "$PORT" -o IdentitiesOnly=yes -o SendEnv='LANG LC_*'
		-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
		-o LogLevel=ERROR -o BatchMode=yes -o ServerAliveInterval=30
		# одно соединение на VM: повторные run/shell не делают новый ssh-handshake
		-o ControlMaster=auto -o ControlPath="$DIR/ssh.sock" -o ControlPersist=10m)
}

ssh_close() { # закрыть фоновое мастер-соединение (перед остановкой/перезапуском VM)
	[[ -S $DIR/ssh.sock ]] || return 0
	ssh_opts
	"${SSH[@]}" -O exit "$VMUSER@127.0.0.1" >/dev/null 2>&1 || true
	rm -f "$DIR/ssh.sock"
}

ssh_ready() {
	ssh_opts
	"${SSH[@]}" -o ConnectTimeout=3 "$VMUSER@127.0.0.1" exit </dev/null >/dev/null 2>&1
}

ssh_why() { # почему ssh не пускает — текст ошибки и что он значит
	local e
	ssh_opts
	# свои опции — первыми (ssh берёт первое значение), без мастер-соединения
	# LogLevel=INFO: «Connection closed by …» на уровне ERROR не печатается
	e=$(ssh -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=5 -o LogLevel=INFO "${SSH[@]:1}" "$VMUSER@127.0.0.1" exit </dev/null 2>&1 >/dev/null |
		tr -d '\r' | grep -v '^Warning: Permanently added' | tail -1) || true
	case $e in
	*'Permission denied'*) echo "$e — в госте нет пользователя $VMUSER или ключа (cloud-init не отработал)" ;;
	*refused* | *'closed by'* | *reset*) echo "${e:-нет ответа} — sshd в госте не запущен" ;;
	'') echo "соединение есть, но команда не выполнилась" ;;
	*) echo "$e" ;;
	esac
}

wait_ssh() { # таймаут в секундах
	local t=${1:-180}
	[[ ${ARCH:-amd64} == arm64 ]] && t=$((t * 4)) # эмуляция: загрузка в разы дольше
	local deadline=$((SECONDS + t))
	until ssh_ready; do
		is_running || die "VM '$NAME' остановилась (lsw logs $NAME)"
		((SECONDS < deadline)) || return 1
		sleep 2
	done
}

# ---------- образы ----------

distro_url() { # distro [amd64|arm64]
	local a=${2:-amd64}
	case $1 in
	ubuntu | ubuntu-26.04) echo "https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-$a.img" ;;
	ubuntu-24.04) echo "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-$a.img" ;;
	ubuntu-22.04) echo "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-$a.img" ;;
	arch) [[ $a == amd64 ]] || return 1; echo https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2 ;;
	*) return 1 ;;
	esac
}

image_file() { # distro [arch] -> путь образа в кеше (может ещё не существовать)
	local d=$1
	[[ $d == ubuntu-26.04 ]] && d=ubuntu
	if [[ ${2:-amd64} == amd64 ]]; then echo "$CACHE/$d.img"; else echo "$CACHE/$d-$2.img"; fi
}

pull_image() { # distro [force] [arch]
	local url f a=${3:-amd64}
	url=$(distro_url "$1" "$a") || die "неизвестный дистрибутив: $1 (ubuntu, ubuntu-24.04, ubuntu-22.04, arch, windows)"
	f=$(image_file "$1" "$a")
	if [[ ! -f $f || ${2:-} == force ]]; then
		mkdir -p "$CACHE"
		info "скачиваю $1: $url"
		curl -fL --progress-bar -o "$f.part" "$url" || die "не удалось скачать образ"
		mv "$f.part" "$f"
	fi
	echo "$f"
}

img_format() { qemu-img info "$1" | awk -F': ' '/^file format/ {print $2}'; }

# ---------- образы: облачные в кеше и найденные ISO ----------

CLOUD_IMAGES=( # дистрибутив арх подпись
	"ubuntu amd64 Ubuntu 26.04"
	"ubuntu-24.04 amd64 Ubuntu 24.04"
	"ubuntu-22.04 amd64 Ubuntu 22.04"
	"arch amd64 Arch Linux"
	"ubuntu arm64 Ubuntu 26.04 arm64"
	"ubuntu-24.04 arm64 Ubuntu 24.04 arm64"
)

iso_dirs() { # где искать ISO: кеш, «Загрузки», LSW_ISO_DIRS (через :)
	local dl
	echo "$CACHE"
	dl=$(xdg-user-dir DOWNLOAD 2>/dev/null) || dl=''
	[[ -n $dl && $dl != "$HOME" ]] || dl=$HOME/Downloads
	echo "$dl"
	[[ -z ${LSW_ISO_DIRS:-} ]] || tr ':' '\n' <<<"$LSW_ISO_DIRS"
}

iso_kind() { # iso -> ubuntu | windows | desktop | arm | unknown — по имени файла, быстро
	local f=${1##*/}
	f=${f,,}
	case $f in
	*arm64* | *aarch64*) echo arm ;;
	*desktop*) echo desktop ;;
	*ubuntu* | *live-server*) echo ubuntu ;;
	win* | *windows*) echo windows ;;
	*) echo unknown ;;
	esac
}

iso_probe() { # iso -> ubuntu | desktop | windows — заглянуть внутрь (для ISO с непонятным именем)
	local tmp info
	tmp=$(mktemp -d)
	xorriso -osirrox on -indev "$1" -extract /.disk/info "$tmp/info" >/dev/null 2>&1 || true
	info=$(cat "$tmp/info" 2>/dev/null || true)
	rm -rf "$tmp"
	if [[ -z $info ]]; then echo windows
	elif [[ $info == *Server* ]]; then echo ubuntu
	else echo desktop; fi
}

iso_label() { # вид iso -> подпись
	local f=${2##*/} v
	case $1 in
	ubuntu)
		v=$(grep -oE '[0-9]{2}\.[0-9]{2}' <<<"$f" | head -1)
		echo "Ubuntu Server${v:+ $v}" ;;
	windows) if grep -qiE 'win(dows)?[ _.-]?11' <<<"$f"; then echo "Windows 11"; else echo "Windows 10"; fi ;;
	desktop) echo "Ubuntu Desktop (нужен Server)" ;;
	arm) echo "ISO arm64 — не поддерживается" ;;
	*) echo ISO ;;
	esac
}

image_scan() { # строки "вид|дистрибутив|арх|путь|подпись"; вид: cloud или вид ISO (iso_kind)
	local e d a l f r k
	local -A seen=()
	for e in "${CLOUD_IMAGES[@]}"; do
		read -r d a l <<<"$e"
		echo "cloud|$d|$a|$(image_file "$d" "$a")|$l"
	done
	while IFS= read -r d; do
		[[ -n $d && -d $d ]] || continue
		for f in "$d"/*.[iI][sS][oO]; do
			[[ -f $f ]] || continue
			r=$(realpath "$f")
			[[ -z ${seen[$r]:-} ]] || continue
			seen[$r]=1
			k=$(iso_kind "$r")
			echo "$k|$([[ $k == windows ]] && echo windows || echo ubuntu)|amd64|$r|$(iso_label "$k" "$r")"
		done
	done < <(iso_dirs)
}

image_meta() { # файл -> "826MiB · 2026-10-14"
	echo "$(human "$(stat -c %s "$1")") · $(stat -c %y "$1" | cut -c1-10)"
}

image_users() { # файл -> имена VM, которым он ещё нужен (ISO недоустановленной VM)
	local d
	for d in "$VMS"/*/; do
		[[ -f $d/vm.conf ]] || continue
		(load_vm "$(basename "$d")" 2>/dev/null && [[ $INSTALLED != 1 && -n $ISO && $ISO -ef $1 ]] && echo "$NAME") || true
	done
}

cmd_pull() { # дистрибутив [--arch arm64]
	local d=${1:-} a=amd64
	[[ -n $d ]] || die "lsw pull <ubuntu|ubuntu-24.04|ubuntu-22.04|arch> [--arch arm64]"
	if [[ ${2:-} == --arch ]]; then
		case ${3:-} in amd64 | x86_64) ;; arm64 | aarch64) a=arm64 ;; *) die "--arch: amd64 или arm64" ;; esac
	fi
	pull_image "$d" force "$a" >/dev/null
	info "образ $d$([[ $a == arm64 ]] && echo ' arm64') обновлён ($(image_meta "$(image_file "$d" "$a")"))"
}

cmd_images() { # [list | rm <файл | дистрибутив[-arm64]>]
	local k d a p l f u hdr=0
	case ${1:-list} in
	list | ls)
		printf '\e[1mОблачные образы\e[0m  %s\n' "${CACHE/#"$HOME"/\~}"
		while IFS='|' read -r k d a p l; do
			if [[ $k == cloud ]]; then
				if [[ -f $p ]]; then printf '  \e[32m✓\e[0m %-30s %-14s %-6s %s\n' "$l" "$d" "$a" "$(image_meta "$p")"
				else printf '  \e[2m- %-30s %-14s %-6s не скачан (скачается при install)\e[0m\n' "$l" "$d" "$a"; fi
				continue
			fi
			((hdr++)) || printf '\n\e[1mISO\e[0m  %s\n' "$(iso_dirs | sed "s|^$HOME|~|" | paste -sd' ')"
			case $k in desktop | arm) f='\e[31m✗\e[0m' ;; *) f='\e[36m◉\e[0m' ;; esac
			printf "  $f %s %s %s\n" "$(t_pad "$l" 30)" "$(t_pad "$(image_meta "$p")" 22)" "${p/#"$HOME"/\~}"
		done < <(image_scan)
		((hdr)) || printf '\nISO не найдены (ищу в: %s)\n' "$(iso_dirs | sed "s|^$HOME|~|" | paste -sd' ')"
		;;
	rm | remove)
		[[ -n ${2:-} ]] || die "lsw images rm <файл в кеше | ubuntu-24.04 | ubuntu-arm64>"
		if [[ $2 == */* ]]; then f=$(realpath -m "$2")
		else f=$CACHE/$2; [[ -f $f ]] || f=$CACHE/$2.img; fi
		[[ -f $f ]] || die "нет такого образа: $2 (lsw images)"
		[[ $(realpath "$(dirname "$f")") == "$(realpath -m "$CACHE")" ]] || die "$f не в кеше lsw — удаляю только оттуда"
		u=$(image_users "$f" | paste -sd' ')
		[[ -z $u ]] || die "${f##*/} ещё нужен для установки: $u"
		l=$(human "$(stat -c %s "$f")")
		rm -f "$f"
		info "удалён ${f##*/}, освобождено $l"
		;;
	*) die "lsw images [list | rm <образ>]" ;;
	esac
}

mkiso() { # dir out label
	xorriso -as mkisofs -o "$2" -V "$3" -J -r "$1" >/dev/null 2>&1 || die "xorriso не смог собрать $2"
}

# ---------- Linux-гость ----------

cloud_body() { # cloud-config гостя без заголовка
	local pass
	pass=$(<"$DIR/password")
	cat <<EOF
hostname: $NAME
users:
  - name: $VMUSER
    gecos: $VMUSER
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: '$pass'
    ssh_authorized_keys:
      - $(<"$KEY.pub")
ssh_pwauth: false
growpart: {mode: auto, devices: ['/']}
EOF
	# в cloud-образе Ubuntu пустые списки apt; на Arch не делаем -Sy (частичное обновление)
	if [[ $DISTRO == ubuntu* ]]; then echo 'package_update: true'; fi
	# запись в fstab есть всегда (nofail): папку можно включить позже через lsw share
	cat <<'EOF'
runcmd:
  - mkdir -p /mnt/host
  - grep -q ' /mnt/host ' /etc/fstab || echo 'host /mnt/host virtiofs defaults,nofail 0 0' >> /etc/fstab
  - mount /mnt/host || true
EOF
}

write_seed() { # user-data-файл -> seed.iso (метка cidata)
	local d=$DIR/seed
	rm -rf "$d" && mkdir -p "$d"
	printf 'instance-id: %s\nlocal-hostname: %s\n' "$NAME-$(date +%s)" "$NAME" >"$d/meta-data"
	cat >"$d/user-data"
	mkiso "$d" "$DIR/seed.iso" cidata
}

make_seed() {
	{ echo '#cloud-config'; cloud_body; } | write_seed
}

# Ubuntu Server ISO: subiquity autoinstall; cloud_body уходит в установленную систему
make_autoinstall_seed() {
	{
		cat <<'EOF'
#cloud-config
autoinstall:
  version: 1
  refresh-installer: {update: false}
  locale: en_US.UTF-8
  keyboard: {layout: us}
  storage: {layout: {name: direct}}
  ssh: {install-server: true, allow-pw: false}
  late-commands:
    - sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty0 console=ttyS0,115200"/' /target/etc/default/grub
    - curtin in-target -- update-grub
  shutdown: poweroff
  user-data:
EOF
		cloud_body | sed 's/^/    /'
	} | write_seed
